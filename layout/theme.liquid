                </svg>
              </a>
            </div>
            <ul class='main-nav__column main-nav__linklist'>
              {% assign half_count = linklists['main-menu'].links.size
                | divided_by: 2
                | round
              %}
              {% for link in linklists['main-menu'].links offset: half_count %}
                <li class='main-nav__link-item'>
                  {% if link.url == '#' and link.title != 'Account' %}
                    <p
                      class='main-nav__link all-caps link--main-nav'
                      id='
                        {%- if link.title == 'Shopping Bag' -%}
                          cart-action
                        {%- else -%}
                          {{ link.handle }}-action
                        {%- endif -%}
                      '
                    >
                      {% if link.title == 'Shopping Bag' %}
                        {{ link.title }}
                        <span class='cart-action__count'
                          >({{ cart.item_count }})</span
                        >
                      {% else %}
                        {{ link.title }}
                      {% endif %}
                    </p>
                  {% else %}
                    <a
                      class='main-nav__link all-caps link--main-nav'
                      id='
                        {%- if link.title == 'Shopping Bag' -%}
                          cart-action
                        {%- else -%}
                          {{ link.handle }}-action
                        {%- endif -%}
                      '
                      href='
                        {%- if link.title == 'Account' -%}
                          {% if shop.customer_accounts_enabled %}
                            {% if customer %}
                              {{ routes.account_url }}
                            {% else %}
                              {{ routes.account_login_url }}
                            {% endif %}
                          {% endif %}
                        {%- else -%}
                          {{ link.url }}
                        {%- endif -%}
                      '
                    >
                      {% if link.title == 'Shopping Bag' %}
                        {{ link.title }}
                        <span class='cart-action__count'
                          >({{ cart.item_count }})</span
                        >
                      {% else %}
                        {{ link.title }}
                      {% endif %}
                    </a>
                  {% endif %}
                </li>
              {% endfor %}
              <li class='main-nav__trigger'>
                <button id='mobile-cart-action'>
                  <span class='all-caps'>
                    Bag
                    <span class='cart-action__count'
                      >({{ cart.item_count }})</span
                    >
                  </span>
                </button>
              </li>
            </ul>
          </div>
        </nav>
        <div class='drawer drawer--menu' id='treatments-menu'>
          <div class='drawer__header'>
            <button class='all-caps drawer__header-action menu-back'>
              Back
            </button>
            <h2 class='drawer__top-level-heading'>Treatments</h2>
            <a
              href='/pages/skin-treatments/'
              class='all-caps drawer__header-action'
              id='treatments-all'
              >View All</a
            >
          </div>
          <ul class='drawer__container'>
            {% for link in linklists['main-menu'].links %}
              {% if link.title == 'Treatments' %}
                {% for child_link in link.links %}
                  <li class='drawer__menu'>
                    <h3 class='all-caps drawer__sub-heading'>
                      {{ child_link.title }}
                    </h3>
                    <ul class='drawer__links-list'>
                      {% for grandchild_link in child_link.links %}
                        <li class='all-caps drawer__link'>
                          <a href='{{ grandchild_link.url }}'>
                            {{- grandchild_link.title -}}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </li>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </ul>
        </div>
        <div class='drawer drawer--menu' id='shop-menu'>
          <div class='drawer__header'>
            <button class='all-caps drawer__header-action menu-back'>
              Back
            </button>
            <h2 class='drawer__top-level-heading'>Shop</h2>
            <a
              href='/collections/all'
              class='all-caps drawer__header-action'
              id='shop-all'
              >Shop All</a
            >
          </div>
          <ul class='drawer__container'>
            {% for link in linklists['main-menu'].links %}
              {% if link.title == 'Shop' %}
                {% for child_link in link.links %}
                  <li class='drawer__menu'>
                    <h3 class='all-caps drawer__sub-heading'>
                      {{ child_link.title }}
                    </h3>
                    <ul class='drawer__links-list'>
                      {% if child_link.title == 'Brands' %}
                        {% for collection in collections %}
                          {%- if collection.metafields.custom.parent_collection
                              == 'brands'
                          -%}
                            <li class='all-caps drawer__link'>
                              <a href='{{ collection.url }}'>
                                {{- collection.title -}}
                              </a>
                            </li>
                          {%- endif -%}
                        {% endfor %}

                      {% else %}
                        {% for grandchild_link in child_link.links %}
                          <li class='all-caps drawer__link'>
                            <a href='{{ grandchild_link.url }}'>
                              {{- grandchild_link.title -}}
                            </a>
                          </li>
                        {% endfor %}
                      {% endif %}
                    </ul>
                  </li>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </ul>
        </div>
        <div class='drawer drawer--menu' id='mobile-menu'>
          <div class='drawer__header'>
            <h2 class='drawer__top-level-heading'>Menu</h2>
            <button class='all-caps drawer__header-action' id='menu-close'>
              Close
            </button>
          </div>
          <ul class='drawer__container'>
            <li class='drawer__menu'>
