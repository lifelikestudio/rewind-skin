      }
      .body-treatments .hero {
        background-image: url('{{ 'treatments_body_hero_desktop_dts_hi-res_compressed.jpg' | asset_url }}');
      }

      @media (max-width: 1055px) {
        .skin-treatments .hero {
          background-image: url('{{ 'treatments_all_hero_tablet_LNK7841_hi-res_compressed.jpg' | asset_url }}');
        }
        .face-treatments .hero {
          background-image: url('{{ 'treatments_face_hero_tablet_22_1004_RewindSkin6814_hi-res_compressed.jpg' | asset_url }}');
        }
        .body-treatments .hero {
          background-image: url('{{ 'treatments_body_hero_tablet_dts_hi-res_compressed.jpg' | asset_url }}');
        }
      }

      @media (max-width: 671px) {
        .skin-treatments .hero {
          background-image: url('{{ 'treatments_all_hero_mobile_LNK7841_hi-res_compressed.jpg' | asset_url }}');
        }
        .face-treatments .hero {
          background-image: url('{{ 'treatments_face_hero_mobile_22_1004_RewindSkin6814_hi-res_compressed.jpg' | asset_url }}');
        }
        .body-treatments .hero {
          background-image: url('{{ 'treatments_body_hero_mobile_dts_hi-res_compressed.jpg' | asset_url }}');
        }
      }
      #shopify-section-opt-in {
        background-image: url('{{ 'global_opt-in_desktop_22_1004_RewindSkin6570_round-03_hi-res_optimized.jpg' | asset_url }}');
      }

      @media (max-width: 1055px) {
        #shopify-section-opt-in {
          background-image: url('{{ 'global_opt-in_tablet_22_1004_RewindSkin6570_round-03_hi-res_optimized.jpg' | asset_url }}');
        }
      }

      @media (max-width: 671px) {
        #shopify-section-opt-in {
          background-image: url('{{ 'global_opt-in_mobile_22_1004_RewindSkin6570_round-03_hi-res_optimized.jpg' | asset_url }}');
        }
      }
      .treatments-category__cta
        .treatments-category__cta-container:first-child {
        background-image: url('{{ 'treatments_shop-skincare_LNK39_hi-res_compressed.jpg' | asset_url }}');
      }
      .treatments-category__cta .treatments-category__cta-container:last-child {
        background-image: url('{{ 'treatments_shop-gifting_LNK7709_hi-res_compressed.jpg' | asset_url }}');
      }
    </style>
