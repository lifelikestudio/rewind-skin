  {% liquid
    if template.suffix
      assign current_template = template.suffix
    else
      assign current_template = template.name
    endif

    assign bodyClass = 'template-' | append: current_template

    if page.title
      assign pageTitle = page.title | handle
      assign bodyClass = bodyClass | append: ' ' | append: pageTitle
    endif
  %}

  <body
    data-customer-logged-in='{% if customer %}true{% else %}false{% endif %}'
    class='{{ bodyClass }}'
  >
    {% if template contains 'index' or template contains 'product' or template contains 'cart' or template contains 'search' or template contains 'login' or template contains 'register' or template contains 'activate_account' or template contains 'reset_password' or template contains 'account' or template contains 'order' or template contains 'addresses' or template == 'page.our-founder' or template == 'page.terms' or template == 'page.privacy' or template == 'page.shipping-returns' or bodyClass == 'template-' or (template.name == 'collection' and collection.handle == 'mansard' or collection.handle == 'adipeau' or collection.handle == 'future-5-elements' or collection.handle == 'biologique-recherche' or collection.handle == 'the-light-salon' or collection.handle == 'calecim-professional' or collection.handle == 'colorescience' or collection.handle == 'ecotao' or collection.handle == 'elta-md' or collection.handle == 'loeuvre-de-beaute' or collection.handle == 'manta' or collection.handle == 'monika-heiligmann' or collection.handle == 'nemat' or collection.handle == 'nuface-microcurrent' or collection.handle == 'skinhaptics' or collection.handle == 'all' or collection.handle == 'subscribe-save' or collection.handle == 'gifting' or collection.handle == 'bestsellers' or collection.handle == 'sales-offers' or collection.handle == 'face' or collection.handle == 'bath-body-hair') %}
      <section class='announcement-bar'>
        <div class='wrapper wrapper--lg announcement-bar__container'>
          {% comment %}
            <a
            class="announcement-bar__type"
            href="https://app.acuityscheduling.com/catalog.php?owner=18442968&category=PROMO+FACIALS"
            target="_blank"
            id="annual-facials-sale"
            >Buy 2 Facials, Get 1 Free. On Now Until September 8th. Book Here.</a
            >
          {% endcomment %}
          {% comment %}
            <a
              class="announcement-bar__type"
              href="/collections/all"
              id="evergreen-announcement"
              style="max-width: 800px;">
              Free Shipping on Orders Over $149 CAD. Start Here.
            </a>
          {% endcomment %}
          {% comment %}
            <a
              class="announcement-bar__type"
              href="/collections/all"
              id="shipping-delays-announcement"
              style="max-width: 800px;">
              Expect shipping delays due to increased holiday volumes and Canada Post strikes. We appreciate your patience.
            </a>
          {% endcomment %}
          {% comment %}
            <a
                                          class="announcement-bar__type"
                                          href="/collections/all?filter.p.vendor=CALECIM+Professional"
                                          id="evergreen-announcement"
                                          style="max-width: 800px;">
                                          CALECIM Professional has arrived. Shop here.
            </a>
          {% endcomment %}
          <a
            class='announcement-bar__type'
            href='/collections/subscribe-save'
            id='evergreen-announcement'
            style='max-width: 800px;'
          >
            Never run out, never pay full price. Subscribe & Save, now live for
            select brands.
          </a>
        </div>
      </section>
      <header>
        <nav class='main-nav'>
          <div class='main-nav__container wrapper wrapper--lg'>
            <ul class='main-nav__column main-nav__linklist'>
              {% assign half_count = linklists['main-menu'].links.size
                | divided_by: 2
                | round
              %}
              {% for link in linklists['main-menu'].links limit: half_count %}
                <li class='main-nav__link-item'>
                  {% if link.url == '#' %}
                    <p
                      class='main-nav__link all-caps link--main-nav'
                      id='{{ link.handle }}-action'
                    >
                      {{- link.title -}}
                    </p>
                  {% else %}
                    <a
                      class='main-nav__link all-caps link--main-nav'
                      id='{{ link.handle }}-action'
                      href='{{ link.url }}'
                    >
                      {{- link.title -}}
                    </a>
                  {% endif %}
                </li>
              {% endfor %}
              <li class='main-nav__trigger'>
                <button id='mobile-action'>
                  <span class='all-caps'>Menu</span>
                </button>
              </li>
            </ul>
            <div class='main-nav__column main-nav__branding'>
              <a class='svg-container' href='/'>
                <svg
                  fill='none'
                  xmlns='http://www.w3.org/2000/svg'
                  viewBox='0 0 249 19'
                  class='svg-content'
                  fill='currentColor'
                  preserveAspectRatio='xMinYMin meet'
                  version='1.1'
