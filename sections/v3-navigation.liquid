        searchRequest = requestController;
        beginSearchLoading(requestId);

        var predictiveUrl = searchDrawer.getAttribute('data-predictive-url');
        var url =
          predictiveUrl +
          '?q=' +
          encodeURIComponent(query) +
          '&resources[type]=query,product,collection,page' +
          '&resources[limit]=10' +
          '&resources[limit_scope]=each' +
          '&section_id=v3-predictive-search';

        fetch(url, { signal: requestController.signal })
          .then(function (response) {
            if (!response.ok) throw new Error('Search request failed');
            return response.text();
          })
          .then(function (markup) {
            searchCache.set(normalizedQuery, markup);
            renderSearchResponse(markup, query, clickedSuggestion, requestId);
          })
          .catch(function (error) {
            if (error.name === 'AbortError') return;
            if (requestId !== searchRequestSequence) return;
            stopSearchLoading();
            if (searchStates) searchStates.setAttribute('aria-busy', 'false');
            if (searchRequest === requestController) searchRequest = null;
            if (searchAnnounce) {
