{% comment %}
  V3 Navigation — MainNav
  Two layouts: desktop (sm+) and mobile (<sm).
  Desktop: Logotype | PriorityLinks (Shop/Studio toggle + Search pill) | SupportingLinks
  Mobile: Logotype | Triggers (Search + Cart + Hamburger)
{% endcomment %}

{%- liquid
  assign cart_count = cart.item_count
  if cart_count > 99
    assign cart_count_desktop = '99+'
  else
    assign cart_count_desktop = cart_count | append: ''
  endif
  if cart_count > 9
    assign cart_count_badge = '9+'
  else
    assign cart_count_badge = cart_count | append: ''
  endif
-%}

<nav
  class='v3-nav bg-bg'
  aria-label='Main navigation'
  data-section-id='{{ section.id }}'
  data-nav-context='shop'
>
  {%- comment -%} ═══ DESKTOP (sm+) ═══ {%- endcomment -%}
  <div
    class='
      hidden items-center justify-between px-[20px]
      py-[24px] sm:flex
      md:px-[24px] md:py-[24px]
      lg:px-[32px] lg:py-[32px]
      xl:px-[40px] xl:py-[40px]
    '
  >
    {%- comment -%} PriorityNav: Logotype + PriorityLinks {%- endcomment -%}
    <div class='flex items-center gap-[40px]'>
      {%- comment -%} Logotype {%- endcomment -%}
      <a
        href='{{ routes.root_url }}'
        class='block shrink-0'
        aria-label='{{ shop.name }}'
        data-nav-logo
      >
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 500
            | image_tag:
              class: 'w-[220px] lg:w-[248px] h-auto',
              widths: '165, 180, 193, 221, 248, 400',
              alt: section.settings.logo.alt
            | default: shop.name
          }}
        {%- else -%}
          <svg
            class='h-auto w-[220px] lg:w-[248px]'
            viewBox='0 0 193.235 14'
            fill='none'
            xmlns='http://www.w3.org/2000/svg'
            aria-label='{{ shop.name }}'
            role='img'
          >
