        submenu.getAttribute('data-submenu-state') === 'open'
      ) {
        closeDrawer();
      }
    });

    /* Context toggle inside the drawer */
    var drawerToggles = submenu.querySelectorAll('[data-submenu-toggle]');
    var announceEl = submenu.querySelector('[data-submenu-announce]');
    var contextSwitching = false;
    var drawerContextTimeline = null;
    var contextFadeEls = [submenu.querySelector('[data-submenu-primary]')]
      .concat(
        Array.from(submenu.querySelectorAll('.v3-submenu__utility-links'))
      )
      .filter(Boolean);

    drawerToggles.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (pillIntentTimer) {
          clearTimeout(pillIntentTimer);
          pillIntentTimer = null;
        }
        var context = btn.getAttribute('data-submenu-toggle');
        var currentContext = submenu.getAttribute('data-context');

        if (context === currentContext) {
          closeDrawer();
        } else if (!contextSwitching) {
          contextSwitching = true;
          updateDrawerToggle(context);
          hideL2();

          drawerContextTimeline = gsap.timeline();
          drawerContextTimeline
            .to(contextFadeEls, {
              opacity: 0,
              duration: motionDurFast,
              ease: 'power1.out',
            })
            .call(function () {
              submenu.setAttribute('data-context', context);
              nav.setAttribute('data-nav-context', context);
              if (announceEl) {
                announceEl.textContent =
                  'Now showing ' +
                  context.charAt(0).toUpperCase() +
                  context.slice(1) +
                  ' navigation';
              }
            })
            .to(contextFadeEls, {
              opacity: 1,
              duration: motionDur,
              ease: 'power1.out',
            })
            .call(function () {
              gsap.set(contextFadeEls, { clearProps: 'opacity' });
              drawerContextTimeline = null;
              contextSwitching = false;
            });
        }
      });
    });

    /* ═══ TOGGLE PILL (hover-preview with snap-back) ═══ */
    var pill = submenu.querySelector('[data-submenu-pill]');
    var pillIntentTimer = null;

    function positionPill(btn, animate) {
      if (!pill) return;
      gsap.killTweensOf(pill);
      if (animate) {
        gsap.to(pill, {
          width: btn.offsetWidth,
          left: btn.offsetLeft,
          duration: motionDur,
          ease: 'power1.out',
        });
      } else {
        gsap.set(pill, { width: btn.offsetWidth, left: btn.offsetLeft });
      }
    }

    function parkPill() {
      var activeBtn = submenu.querySelector(
        '[data-submenu-toggle][aria-pressed="true"]'
      );
      if (activeBtn) positionPill(activeBtn, true);
    }

    function initPill() {
      var activeBtn = submenu.querySelector(
        '[data-submenu-toggle][aria-pressed="true"]'
      );
      if (activeBtn && pill) {
        pill.style.width = activeBtn.offsetWidth + 'px';
        pill.style.left = activeBtn.offsetLeft + 'px';
      }
    }

    initPill();

    function previewOn(btn) {
      toggleGroup.setAttribute('data-pill-preview', '');
      btn.setAttribute('data-previewing', '');
    }

    function previewOff() {
      toggleGroup.removeAttribute('data-pill-preview');
      drawerToggles.forEach(function (b) {
        b.removeAttribute('data-previewing');
      });
    }

    if (hasHover && pill && toggleGroup) {
      drawerToggles.forEach(function (btn) {
        btn.addEventListener('mouseenter', function () {
          if (pillIntentTimer) {
            clearTimeout(pillIntentTimer);
            pillIntentTimer = null;
          }
          pillIntentTimer = setTimeout(function () {
            positionPill(btn, true);
            previewOn(btn);
            pillIntentTimer = null;
          }, 120);
        });

        btn.addEventListener('mouseleave', function () {
          if (pillIntentTimer) {
            clearTimeout(pillIntentTimer);
            pillIntentTimer = null;
          }
          previewOff();
          parkPill();
        });
      });

      toggleGroup.addEventListener('mouseleave', function () {
        if (pillIntentTimer) {
          clearTimeout(pillIntentTimer);
          pillIntentTimer = null;
        }
        previewOff();
        parkPill();
      });

      window.addEventListener('resize', function () {
        if (submenu.getAttribute('data-submenu-state') === 'open') {
          initPill();
        }
      });
    }

    /* ═══ L2 REVEAL ═══ */
    if (primary && hasHover) {
      /* Pointer devices: hover intent */
      primary.addEventListener('mouseover', function (e) {
        if (submenu.getAttribute('data-submenu-state') !== 'open') return;
        if (e.target.closest('.v3-submenu__l2')) return;

        var l1Link = e.target.closest('.v3-submenu__l1-link');
        if (l1Link && l1Link.hasAttribute('data-has-l2')) {
          showL2(l1Link.getAttribute('data-l1'), l1Link);
        } else if (l1Link || e.target.closest('.v3-submenu__subgroup-title')) {
          hideL2();
        }
      });

      primary.addEventListener('mouseleave', function () {
        hideL2();
      });
    }

    if (primary) {
      /* Touch devices use tap. On hover-capable devices, only keyboard-
         generated clicks toggle the disclosure, preserving mouse hover. */
      var l2Buttons = primary.querySelectorAll('[data-has-l2]');
      l2Buttons.forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          if (submenu.getAttribute('data-submenu-state') !== 'open') return;
          if (hasHover && e.detail !== 0) return;
          var slug = btn.getAttribute('data-l1');
          var context = submenu.getAttribute('data-context');
          var panel = submenu.querySelector(
            '[data-l2="' + slug + '"][data-l2-context="' + context + '"]'
          );
          if (activeL2 === panel) {
            hideL2();
          } else {
            showL2(slug, btn, hasHover);
          }
        });
      });
    }

    function showL2(slug, l1Link, moveFocus) {
      var context = submenu.getAttribute('data-context');
      var panel = submenu.querySelector(
        '[data-l2="' + slug + '"][data-l2-context="' + context + '"]'
      );
      if (!panel || panel === activeL2) return;

      if (activeL2) {
        gsap.killTweensOf(activeL2);
        activeL2.classList.remove('is-active');
        activeL2.style.paddingTop = '';
        gsap.set(activeL2, { clearProps: 'opacity' });
      }

      var prevTrigger = submenu.querySelector(
        '[data-has-l2][aria-expanded="true"]'
      );
      if (prevTrigger) prevTrigger.setAttribute('aria-expanded', 'false');
      l1Link.setAttribute('aria-expanded', 'true');

      panel.classList.add('is-active');
      primary.classList.add('has-l2');
      activeL2 = panel;

      /* Baseline alignment: position first L2 link so its baseline
         aligns with the hovered L1 link's baseline. Both use Capsize
         cap-height trim, so getBoundingClientRect bottom ≈ text baseline. */
      var firstL2Link = panel.querySelector('.v3-submenu__l2-link');
      if (firstL2Link) {
        var l1Rect = l1Link.getBoundingClientRect();
        var panelRect = panel.getBoundingClientRect();
        var l1BaselineY = l1Rect.bottom - panelRect.top;
        var l2Height = firstL2Link.getBoundingClientRect().height;
        panel.style.paddingTop = Math.max(0, l1BaselineY - l2Height) + 'px';
      }

      gsap.set(panel, { opacity: 0 });
      gsap.to(panel, {
        opacity: 1,
        duration: reducedMotion ? 0 : 0.25,
        ease: 'power1.out',
        onComplete: function () {
          gsap.set(panel, { clearProps: 'opacity' });
          if (moveFocus && activeL2 === panel) {
            var firstLink = panel.querySelector('.v3-submenu__l2-link');
            if (firstLink) firstLink.focus();
          }
        },
      });
    }

    function hideL2() {
      if (!activeL2) return;
      var closing = activeL2;
      gsap.killTweensOf(closing);
      activeL2 = null;
      if (primary) primary.classList.remove('has-l2');

      var expandedTrigger = submenu.querySelector(
        '[data-has-l2][aria-expanded="true"]'
      );
      if (expandedTrigger)
        expandedTrigger.setAttribute('aria-expanded', 'false');

      gsap.to(closing, {
        opacity: 0,
        duration: motionDur,
        ease: 'power1.out',
        onComplete: function () {
          closing.classList.remove('is-active');
          closing.style.paddingTop = '';
          gsap.set(closing, { clearProps: 'opacity' });
        },
      });
    }

    /* ═══ LINK HOVER INTENT (de-emphasis on deliberate stop) ═══ */
    if (hasHover) {
      var linkIntentTimer = null;
      var focusedLink = null;

      function clearLinkIntent() {
        if (linkIntentTimer) {
          clearTimeout(linkIntentTimer);
          linkIntentTimer = null;
        }
        if (focusedLink) {
          var group = focusedLink.closest(
            '[data-l1-group], .v3-submenu__l2, .v3-submenu__utility-links'
          );
          if (group) group.removeAttribute('data-link-focused');
          focusedLink.removeAttribute('data-focused');
          focusedLink = null;
        }
      }

      drawer.addEventListener('mouseover', function (e) {
        var link = e.target.closest(
          '.v3-submenu__l1-link, .v3-submenu__l2-link, .v3-submenu__utility-link'
        );
        if (link === focusedLink) return;

        clearLinkIntent();

        if (!link) return;

        linkIntentTimer = setTimeout(function () {
          var group = link.closest(
            '[data-l1-group], .v3-submenu__l2, .v3-submenu__utility-links'
          );
          if (group) group.setAttribute('data-link-focused', '');
          link.setAttribute('data-focused', '');
          focusedLink = link;
          linkIntentTimer = null;
        }, 150);
      });

      drawer.addEventListener('mouseleave', function () {
        clearLinkIntent();
      });
    }

    /* ═══ FOCUS TRAP ═══ */
    drawer.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      if (submenu.getAttribute('data-submenu-state') !== 'open') return;

      var focusables = drawer.querySelectorAll(
        'a[href]:not([tabindex="-1"]), button:not([disabled]):not([tabindex="-1"])'
      );
      var visible = Array.from(focusables).filter(function (el) {
        return el.offsetParent !== null;
      });
      if (!visible.length) return;

      var first = visible[0];
      var last = visible[visible.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    /* ═══ NAVIGATION EXIT (internal link → fade → navigate) ═══
       When a visitor clicks an internal link inside the open drawer,
       play the closing fade before navigating so the transition feels
       resolved rather than torn away. External links, modifier-key
       clicks, and reduced-motion preferences all bypass this. */
    var navigating = false;

    drawer.addEventListener('click', function (e) {
      if (navigating) return;
      if (submenu.getAttribute('data-submenu-state') !== 'open') return;

      var link = e.target.closest('a[href]');
      if (!link || !drawer.contains(link)) return;
      if (link.target === '_blank' || link.hasAttribute('download')) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      try {
        var url = new URL(link.href, window.location.origin);
        if (url.origin !== window.location.origin) return;
      } catch (_) {
        return;
      }

      if (reducedMotion) return;

      e.preventDefault();
      navigating = true;

      submenu.setAttribute('data-submenu-state', 'closing');
      submenu.setAttribute('aria-hidden', 'true');
      nav.removeAttribute('data-nav-shared-fade');
      clearModalIsolation();

      gsap.delayedCall(motionDur, function () {
        link.click();
      });
    });

    function resetMobileMenuState() {
      if (!mobileMenu) return;
      if (mobileCloseTimer) {
        clearTimeout(mobileCloseTimer);
        mobileCloseTimer = null;
      }
      if (mobileDrillTimeline) {
        mobileDrillTimeline.kill();
        mobileDrillTimeline = null;
      }
      if (mobileContextTimeline) {
        mobileContextTimeline.kill();
        mobileContextTimeline = null;
      }
      mobileMenu
        .querySelectorAll('.v3-mobile-menu__l2.is-active')
        .forEach(function (panel) {
          gsap.killTweensOf(panel);
          panel.classList.remove('is-active');
          gsap.set(panel, { clearProps: 'opacity' });
        });
      activeMobileL2 = null;
      mobileMenu
        .querySelectorAll('[data-mobile-l1][aria-expanded="true"]')
        .forEach(function (btn) {
          btn.setAttribute('aria-expanded', 'false');
        });
      activeMobileTrigger = null;
      mobileDrilling = false;
      mobileContextSwitching = false;
      mobileNavigating = false;
      if (mobileL1View) {
        gsap.killTweensOf(mobileL1View);
        mobileL1View.classList.remove('is-hidden');
        gsap.set(mobileL1View, { clearProps: 'opacity' });
      }
      mobileMenu.setAttribute('data-mobile-menu-state', 'closed');
      mobileMenu.setAttribute('aria-hidden', 'true');
      if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
    }

    function resetDesktopDrawerState() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      if (drawerContextTimeline) {
        drawerContextTimeline.kill();
        drawerContextTimeline = null;
      }
      submenu
        .querySelectorAll('.v3-submenu__l2.is-active')
        .forEach(function (panel) {
          gsap.killTweensOf(panel);
          panel.classList.remove('is-active');
          panel.style.paddingTop = '';
          gsap.set(panel, { clearProps: 'opacity' });
        });
      activeL2 = null;
      if (primary) primary.classList.remove('has-l2');
      submenu
        .querySelectorAll('[data-has-l2][aria-expanded="true"]')
        .forEach(function (btn) {
          btn.setAttribute('aria-expanded', 'false');
        });
      toggleBtns.forEach(function (btn) {
        btn.setAttribute('aria-expanded', 'false');
      });
      submenu.setAttribute('data-submenu-state', 'closed');
      submenu.setAttribute('aria-hidden', 'true');
      nav.removeAttribute('data-nav-shared-fade');
      openTrigger = null;
      contextSwitching = false;
      navigating = false;
    }

    /* Dismiss only the navigation modal belonging to the layout being left.
       Search is shared across layouts, so keep it open and move its eventual
       focus return to the newly visible trigger. */
    var navigationBreakpoint = 768;
    var wasDesktop = window.innerWidth >= navigationBreakpoint;

    window.addEventListener('resize', function () {
      var isDesktop = window.innerWidth >= navigationBreakpoint;
      if (isDesktop === wasDesktop) return;
      wasDesktop = isDesktop;

      var searchIsOpen =
        searchDrawer &&
        searchDrawer.getAttribute('data-search-state') === 'open';
      if (searchIsOpen) {
        discardSearchTransfer();
        nav.toggleAttribute('data-nav-search-fade', isDesktop);
        searchOpenTrigger = isDesktop
          ? searchTrigger
          : nav.querySelector('[data-nav-search-mobile]');
      }

      if (isDesktop && mobileMenu) {
        var mobileState = mobileMenu.getAttribute('data-mobile-menu-state');
        if (mobileState === 'open' || mobileState === 'closing') {
          resetMobileMenuState();
          if (!searchIsOpen) {
            clearModalIsolation();
            var desktopContext = mobileMenu.getAttribute(
              'data-mobile-menu-context'
            );
            var desktopTrigger = nav.querySelector(
              '[data-nav-toggle="' + desktopContext + '"]'
            );
            if (desktopTrigger) desktopTrigger.focus();
          }
        }
      } else if (!isDesktop) {
        var desktopState = submenu.getAttribute('data-submenu-state');
        if (desktopState === 'open' || desktopState === 'closing') {
          resetDesktopDrawerState();
          if (!searchIsOpen) {
            clearModalIsolation();
            if (hamburger) hamburger.focus();
          }
        }
      }
    });

    /* A page may be frozen with a modal open. Always release isolation
       before it enters or returns from the back-forward cache. */
    window.addEventListener('pagehide', function () {
      resetMobileMenuState();
      resetDesktopDrawerState();
      if (searchDrawer) resetSearchDrawerState();
      clearModalIsolation();
    });

    window.addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      resetMobileMenuState();
      resetDesktopDrawerState();
      if (searchDrawer) resetSearchDrawerState();
      clearModalIsolation();
    });
  })();
</script>

