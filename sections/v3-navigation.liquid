{% comment %}
  V3 Navigation — MainNav
  Two layouts: desktop (SM and above) and mobile (below SM).
  Desktop: Logotype | PriorityLinks (Shop/Studio toggle + Search pill) | SupportingLinks
  Mobile: Logotype | Triggers (Search + Cart + Hamburger)

  Dynamic menu contract (settings are intentionally dormant for now):
  - Desktop and mobile share Shop/Studio main, featured, and utility menus.
  - Main menu top-level links are L1; their children are L2.
  - L1 links with children are disclosures and ignore their own URL.
  - Featured and utility menus are flat.
  - External destinations open in a new tab with noopener/noreferrer.
{% endcomment %}

{%- liquid
  assign cart_count = cart.item_count
  assign cart_bag_label = 'sections.v3_cart.bag' | t
  assign cart_item_label = 'sections.v3_cart.items' | t
  if cart_count == 1
    assign cart_item_label = 'sections.v3_cart.item' | t
  endif
  if cart_count > 99
    assign cart_count_desktop = '99+'
  else
    assign cart_count_desktop = cart_count | append: ''
  endif
  if cart_count > 9
    assign cart_count_badge = '9+'
  else
    assign cart_count_badge = cart_count | append: ''
  endif
-%}

<nav
  class='v3-nav bg-bg'
  aria-label='{{ 'sections.v3_navigation.main_navigation' | t | escape }}'
  data-section-id='{{ section.id }}'
  data-nav-context='shop'
>
  {%- comment -%} ═══ DESKTOP (sm+) ═══ {%- endcomment -%}
  <div
    class='
      hidden items-center justify-between px-[20px]
      py-[24px] sm:flex
      md:px-[24px] md:py-[24px]
      lg:px-[32px] lg:py-[32px]
      xl:px-[40px] xl:py-[40px]
    '
  >
    {%- comment -%} PriorityNav: Logotype + PriorityLinks {%- endcomment -%}
    <div class='flex items-center gap-[40px]'>
      {%- comment -%} Logotype {%- endcomment -%}
      <a
        href='{{ routes.root_url }}'
        class='block shrink-0'
        aria-label='{{ shop.name }}'
        data-nav-logo
      >
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 500
            | image_tag:
              class: 'w-[220px] lg:w-[248px] h-auto',
              widths: '165, 180, 193, 221, 248, 400',
              alt: section.settings.logo.alt
            | default: shop.name
          }}
