      var searchOpenTrigger = null;
      var searchOriginTrigger = null;
      var searchNavigating = false;
      var searchTransferTimeline = null;
      var searchRevealTimeline = null;
      var mobileTransferBackdrop = null;
      var mobileMenuLogoParent = mobileMenuLogo
