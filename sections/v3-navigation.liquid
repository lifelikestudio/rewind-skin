            <path d="M191.565 0.528646H193.235V13.789H191.565L177.828 2.53619V13.8419H176.158V0.528646H177.828L191.511 11.7815V0.528646H191.565Z" fill="currentColor"/>
          </svg>
        {%- endif -%}
      </a>

      {%- comment -%} PriorityLinks {%- endcomment -%}
      <div class='group/priority flex items-center gap-[8px]'>
        {%- comment -%} Shop/Studio toggle (MainPathsGroup) {%- endcomment -%}
        <div
          class='bg-rest rounded-pill relative flex items-center gap-[4px] p-[4px]'
          role='group'
          aria-label='Navigation context'
          data-nav-paths
        >
          <span
            class='v3-nav__slider rounded-pill bg-hover pointer-events-none absolute top-[4px] h-[calc(100%_-_8px)] opacity-0'
            aria-hidden='true'
          ></span>
          <button
            type='button'
            class='v3-nav__switch-btn rounded-pill text-nav-label font-base text-ink relative z-[1] h-[30px] px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
            data-nav-toggle='shop'
          >
            {{ section.settings.shop_label | default: 'Shop' }}
          </button>
          <button
            type='button'
            class='v3-nav__switch-btn rounded-pill text-nav-label font-base text-ink relative z-[1] h-[30px] px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
            data-nav-toggle='studio'
          >
            {{ section.settings.studio_label | default: 'Studio' }}
          </button>
        </div>

        {%- comment -%} Search pill (NavBtnIcon) {%- endcomment -%}
        {%- if section.settings.show_search -%}
          <button
            type='button'
            class='v3-nav__search-pill bg-rest rounded-pill flex h-[38px] items-center gap-[8px] pr-[5px] pl-[18px] transition-colors duration-150 ease-out lg:h-[40px] lg:pr-[6px]'
            aria-label='Search'
            data-nav-search
          >
            <span class='text-nav-label font-base text-ink tracking-tight transition-colors duration-150 ease-out'
              >Search</span
            >
            <span class='bg-hover rounded-pill flex h-[28px] w-[28px] items-center justify-center transition-colors duration-150 ease-out'>
              {%- render 'v3-icon-search',
                size: 11,
                class: 'w-[10px] lg:w-[11px] h-[10px] lg:h-[11px] text-ink'
              -%}
            </span>
          </button>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} SupportingLinks (right group) {%- endcomment -%}
    <div
      class='group/supporting flex items-center justify-end gap-[4px]'
      style='padding-right: calc(var(--v3-nav-pr-offset, 0px));'
    >
      {%- if section.settings.show_cart -%}
        <button
          type='button'
          class='v3-nav__naked-btn rounded-pill text-nav-label font-base text-ink flex h-[30px] items-center px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
          id='v3-cart-btn'
          data-nav-cart
        >
          Bag
          {%- if cart_count > 0 -%}&nbsp;
            <span class='v3-nav__cart-count' aria-live='polite'>
              ({{ cart_count_display }})</span
            >
          {%- endif %}
        </button>
      {%- endif -%}

      {%- if section.settings.show_wishlist -%}
        <button
          type='button'
          class='v3-nav__naked-btn rounded-pill text-nav-label font-base text-ink flex h-[30px] items-center px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
          data-nav-wishlist
        >
          Wishlist
        </button>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a
          href='{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}'
          class='v3-nav__naked-btn rounded-pill text-nav-label font-base text-ink flex h-[30px] items-center px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
        >
          Account
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ═══ MOBILE (<sm) ═══ {%- endcomment -%}
  <div
    class='
      xxs:h-[76px] xs:h-[80px] xxs:pl-[14px] xs:pl-[16px]
      xxs:pr-[11px] xs:pr-[12px] flex
      h-[76px] items-center justify-between
      pr-[11px] pl-[14px] sm:hidden
    '
  >
    {%- comment -%} Logotype {%- endcomment -%}
    <a
      href='{{ routes.root_url }}'
      class='block shrink-0'
      aria-label='{{ shop.name }}'
    >
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag:
            class: 'w-[165px] xxs:w-[179px] xs:w-[193px] h-auto',
            widths: '165, 179, 193, 330, 358, 386',
            alt: section.settings.logo.alt
          | default: shop.name
        }}
      {%- else -%}
        <svg
          class='xxs:w-[179px] xs:w-[193px] h-auto w-[165px]'
          viewBox='0 0 193.235 14'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
          aria-label='{{ shop.name }}'
          role='img'
        >
          <path d="M17.5621 13.7362L17.5083 13.789H15.3534L9.69689 8.08336H1.67002V13.8419H0V0.528646H10.9359C12.0134 0.528646 12.9831 0.581476 13.7373 0.739967C14.4915 0.898457 15.1918 1.10978 15.7305 1.47959C16.7541 2.11355 17.2928 3.01166 17.2928 4.27959C17.2928 5.49468 16.8079 6.3928 15.8921 7.02676C14.9763 7.66072 13.5756 8.03053 11.744 8.08336L17.5621 13.7362ZM1.67002 1.95506V6.65695H10.4511C11.5824 6.65695 12.4443 6.60412 13.0908 6.49846C13.6834 6.3928 14.1682 6.23431 14.5453 6.07582C15.2457 5.706 15.5689 5.12487 15.5689 4.27959C15.5689 3.43431 15.2457 2.85317 14.5453 2.48336C14.2221 2.27204 13.7373 2.16638 13.0908 2.06072C12.4982 1.95506 11.6363 1.95506 10.4511 1.95506H1.67002Z" fill="currentColor"/>
