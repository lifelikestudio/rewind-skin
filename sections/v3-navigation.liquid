          requestSearchProducts(query, 1, requestId, true);
        }
      }

      function requestSearch(query, clickedSuggestion, requestId) {
        var normalizedQuery = normalizeSearchText(query);
        if (requestId !== searchRequestSequence || !normalizedQuery) return;
        if (searchRequest) searchRequest.abort();
        if (searchCache.has(normalizedQuery)) {
          stopSearchLoading();
          if (searchStates) searchStates.setAttribute('aria-busy', 'false');
          renderSearchResponse(
            searchCache.get(normalizedQuery),
            query,
            clickedSuggestion,
            requestId
          );
