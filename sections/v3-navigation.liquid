  "class": "v3-navigation-section",
  "settings": [
    {
      "type": "header",
      "content": "Logotype"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "header",
      "content": "Navigation context"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop toggle label",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "studio_label",
      "label": "Studio toggle label",
      "default": "Studio"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu",
      "info": "Links shown when Shop context is active"
    },
    {
      "type": "link_list",
      "id": "studio_menu",
      "label": "Studio menu",
      "info": "Links shown when Studio context is active"
    },
    {
      "type": "header",
      "content": "Elements"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show bag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "select",
      "id": "sticky_type",
      "label": "Sticky behaviour",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "always", "label": "Always visible" },
        { "value": "on-scroll-up", "label": "Show on scroll up" }
      ],
      "default": "always"
    }
  ],
  "presets": [
    {
      "name": "V3 Navigation"
    }
  ]
}
