            searchHasRenderedResults &&
            searchPredictive &&
            searchPredictive.children.length
          ) {
            searchDrawer.setAttribute('data-search-loading', 'retained');
          } else {
            searchDrawer.setAttribute('data-search-loading', 'first');
            setSearchView('loading');
          }
          if (searchAnnounce)
            searchAnnounce.textContent = 'Loading search results';
        }, 300);
      }

      function disconnectSearchProductsObserver() {
        if (!searchProductsObserver) return;
        searchProductsObserver.disconnect();
        searchProductsObserver = null;
      }

      function abortSearchProductsRequest() {
        if (!searchProductsRequest) return;
        searchProductsRequest.abort();
        searchProductsRequest = null;
      }

      function setSearchProductsBusy(isBusy) {
        searchProductsLoading = isBusy;
        searchDrawer.toggleAttribute(
          'data-search-products-loading-more',
          isBusy && searchProductsPage > 0
        );
        var productsGroup = searchPredictive
          ? searchPredictive.querySelector(
              '[data-search-products-group], [data-search-results-group="products"]'
            )
          : null;
        if (productsGroup) {
          productsGroup.setAttribute('aria-busy', String(isBusy));
        }
      }

      function initialiseSearchProductImages(root) {
        if (!root) return;
        root
          .querySelectorAll('[data-search-product-image]')
          .forEach(function (imageFrame) {
            if (imageFrame.hasAttribute('data-search-image-bound')) return;
            imageFrame.setAttribute('data-search-image-bound', '');

            var image = imageFrame.querySelector('img');
            if (!image) {
              imageFrame.removeAttribute('data-search-image-loading');
              imageFrame.setAttribute('data-search-image-loaded', '');
              return;
            }

            function markImageLoaded() {
              imageFrame.removeAttribute('data-search-image-loading');
              imageFrame.setAttribute('data-search-image-loaded', '');
            }

            if (image.complete) {
              markImageLoaded();
              return;
            }

            image.addEventListener('load', markImageLoaded, { once: true });
            image.addEventListener('error', markImageLoaded, { once: true });
          });
      }

      searchDrawer.setAttribute('data-search-images-enhanced', '');
      initialiseSearchProductImages(searchDrawer);

      function updateSearchProductsAvailability() {
        var hasMore =
          searchProductsRetryPage !== null ||
          (searchProductsPages > 0 && searchProductsPage < searchProductsPages);
        searchDrawer.toggleAttribute('data-search-has-more-products', hasMore);
        return hasMore;
      }

      function resetSearchProducts() {
        abortSearchProductsRequest();
        disconnectSearchProductsObserver();
        searchProductsQuery = '';
        searchProductsPage = 0;
        searchProductsPages = 0;
        searchProductsCount = 0;
        searchProductsRetryPage = null;
        searchProductsClickedSuggestion = false;
        setSearchProductsBusy(false);
        searchDrawer.removeAttribute('data-search-has-more-products');
      }

      function buildSearchProductsUrl(query, page) {
        var searchUrl = searchForm
          ? searchForm.action
          : '{{ routes.search_url }}';
        var url = new URL(searchUrl, window.location.origin);
        url.searchParams.set('q', query);
        url.searchParams.set('type', 'product');
        url.searchParams.set('options[unavailable_products]', 'hide');
        url.searchParams.set('options[prefix]', 'last');
        url.searchParams.set('page', String(page));
        url.searchParams.set('section_id', 'v3-search-products');
        return url.toString();
      }

      function setupSearchProductsObserver() {
        disconnectSearchProductsObserver();
        if (
          !searchScroll ||
          !('IntersectionObserver' in window) ||
          !updateSearchProductsAvailability()
        ) {
          return;
        }

        var sentinel = searchPredictive
          ? searchPredictive.querySelector('[data-search-products-sentinel]')
          : null;
        if (!sentinel) return;

        searchProductsObserver = new IntersectionObserver(
          function (entries) {
            if (
              entries.some(function (entry) {
                return entry.isIntersecting;
              })
            ) {
              loadNextSearchProducts();
            }
          },
          { root: searchScroll, threshold: 0 }
        );
        searchProductsObserver.observe(sentinel);
      }

      function applySearchProductsResponse(
        markup,
        query,
        page,
        requestId,
        replaceProducts
      ) {
        if (requestId !== searchRequestSequence) return;
        if (
          normalizeSearchText(searchInput ? searchInput.value : '') !==
          normalizeSearchText(query)
        ) {
          return;
        }

        var documentFragment = new DOMParser().parseFromString(
          markup,
          'text/html'
        );
        var productsResponse = documentFragment.querySelector(
          '[data-search-products-response]'
        );
        if (!productsResponse) {
          throw new Error('Product search response is missing');
        }

        var responsePage = Number(
          productsResponse.getAttribute('data-search-products-page')
        );
        var responsePages = Number(
          productsResponse.getAttribute('data-search-products-pages')
        );
        var responseCount = Number(
          productsResponse.getAttribute('data-search-products-count')
        );
        var incomingGroup = productsResponse.querySelector(
          '[data-search-products-group]'
        );
        var currentResponse = searchPredictive
          ? searchPredictive.querySelector('[data-search-response]')
          : null;
        var currentGroup = currentResponse
          ? currentResponse.querySelector(
              '[data-search-results-group="products"]'
            )
          : null;
        var appendedCount = 0;
        var appendedCards = [];

        if (replaceProducts) {
          if (incomingGroup && currentGroup) {
            currentGroup.replaceWith(incomingGroup);
          } else if (incomingGroup && currentResponse) {
            currentResponse.appendChild(incomingGroup);
          } else if (currentGroup) {
            currentGroup.remove();
          }
        } else {
          var incomingList = incomingGroup
            ? incomingGroup.querySelector('[data-search-products-list]')
            : null;
          var currentList = currentGroup
            ? currentGroup.querySelector('[data-search-products-list]')
            : null;
          if (!incomingList || !currentList) {
            throw new Error('Product search page is missing');
          }
          appendedCount = incomingList.children.length;
          Array.from(incomingList.children).forEach(function (productCard) {
            appendedCards.push(productCard);
            currentList.appendChild(productCard);
          });
        }

        initialiseSearchProductImages(currentResponse);
        if (appendedCards.length && !reducedMotion) {
          gsap.fromTo(
            appendedCards,
            { opacity: 0, y: 4 },
            {
              opacity: 1,
              y: 0,
              duration: 0.25,
              ease: 'power1.out',
              stagger: 0.03,
              clearProps: 'opacity,transform',
              overwrite: 'auto',
            }
          );
        }

        searchProductsQuery = query;
        searchProductsPage = responsePage || page;
        searchProductsPages = responsePages || 0;
        searchProductsCount = responseCount || 0;
        searchProductsRetryPage = null;
        setSearchProductsBusy(false);

        var actionableCount = currentResponse
          ? currentResponse.querySelectorAll('[data-search-result-link]').length
          : 0;
        searchDrawer.toggleAttribute(
          'data-search-has-results',
          actionableCount > 0
        );
        searchCompletedRequestId = requestId;
        searchCompletedQuery = query;
        searchCompletedHasResults = actionableCount > 0;

        var footerWasVisible =
          searchFooter &&
          window.getComputedStyle(searchFooter).display !== 'none';
        var hasMore = updateSearchProductsAvailability();
        if (hasMore) {
          setupSearchProductsObserver();
          if (!footerWasVisible) revealSearchFooter();
        } else {
          disconnectSearchProductsObserver();
        }

        if (
          searchProductsCount > 0 &&
          searchDrawer.getAttribute('data-search-view') === 'no-results'
        ) {
          setSearchView(
            searchProductsClickedSuggestion ? 'clicked' : 'autocomplete'
          );
        }

        if (searchAnnounce) {
          if (replaceProducts) {
            searchAnnounce.textContent =
              searchProductsCount +
              ' product ' +
              (searchProductsCount === 1 ? 'result' : 'results') +
              ' available';
          } else if (hasMore) {
            searchAnnounce.textContent =
              'Loaded ' + appendedCount + ' more products';
          } else {
            searchAnnounce.textContent =
              'All ' + searchProductsCount + ' products loaded';
          }
        }
      }

      function requestSearchProducts(query, page, requestId, replaceProducts) {
        if (
          requestId !== searchRequestSequence ||
          !normalizeSearchText(query) ||
          searchProductsLoading
        ) {
          return;
        }

        abortSearchProductsRequest();
        disconnectSearchProductsObserver();
        searchProductsQuery = query;
        searchProductsRetryPage = null;
        setSearchProductsBusy(true);

        var requestController = new AbortController();
        searchProductsRequest = requestController;

        fetch(buildSearchProductsUrl(query, page), {
          signal: requestController.signal,
        })
          .then(function (response) {
            if (!response.ok) throw new Error('Product search request failed');
            return response.text();
          })
          .then(function (markup) {
            applySearchProductsResponse(
              markup,
              query,
              page,
              requestId,
              replaceProducts
            );
            if (searchProductsRequest === requestController) {
              searchProductsRequest = null;
            }
          })
          .catch(function (error) {
            if (error.name === 'AbortError') return;
            if (requestId !== searchRequestSequence) return;
            searchProductsRequest = null;
            searchProductsRetryPage = page;
            setSearchProductsBusy(false);
            updateSearchProductsAvailability();
            disconnectSearchProductsObserver();
            if (searchAnnounce) {
              searchAnnounce.textContent =
                'More products could not be loaded. Try again.';
            }
          });
      }

      function loadNextSearchProducts() {
        if (searchProductsLoading || !searchProductsQuery) return;
        var nextPage =
          searchProductsRetryPage !== null
            ? searchProductsRetryPage
            : searchProductsPage + 1;
        if (
          searchProductsRetryPage === null &&
          (!searchProductsPages || nextPage > searchProductsPages)
        ) {
          searchDrawer.removeAttribute('data-search-has-more-products');
          disconnectSearchProductsObserver();
          return;
        }
        requestSearchProducts(
          searchProductsQuery,
          nextPage,
          searchRequestSequence,
          nextPage === 1
        );
      }

      function resetSearchResults(animate) {
        searchRequestSequence += 1;
        if (searchDebounceTimer) {
          clearTimeout(searchDebounceTimer);
          searchDebounceTimer = null;
        }
        if (searchRequest) {
          searchRequest.abort();
          searchRequest = null;
        }
        stopSearchLoading();
        resetSearchProducts();
        searchHasRenderedResults = false;
        searchCompletedHasResults = false;
        searchDrawer.removeAttribute('data-search-has-results');
        if (searchLoadingPreview) {
          searchDrawer.setAttribute('data-search-loading', 'first');
          if (searchStates) searchStates.setAttribute('aria-busy', 'true');
          setSearchView('loading', true, function () {
            if (searchPredictive) searchPredictive.innerHTML = '';
          });
          return;
        }
        if (searchStates) searchStates.setAttribute('aria-busy', 'false');
        setSearchView('initial', !animate, function () {
          if (searchPredictive) searchPredictive.innerHTML = '';
        });
      }

      renderRecentSearches();
      if (searchLoadingPreview) {
        searchDrawer.setAttribute('data-search-loading', 'first');
        searchDrawer.setAttribute('data-search-view', 'loading');
        if (searchStates) searchStates.setAttribute('aria-busy', 'true');
      }

      if (searchRecentClear) {
        searchRecentClear.addEventListener('click', function () {
          try {
            window.localStorage.removeItem(recentSearchStorageKey);
          } catch (_) {
            return;
          }

          if (
            !searchRecentSection ||
            reducedMotion ||
            searchRecentSection.hidden
          ) {
            renderRecentSearches();
          } else {
            var recentParts = Array.from(
              searchRecentSection.querySelectorAll(
                '.v3-search__subgroup-heading, .v3-search__suggestion'
              )
            );
            var parentGap = searchStates
              ? parseFloat(window.getComputedStyle(searchStates).rowGap) || 0
              : 0;

            searchRecentClear.disabled = true;
            searchRecentSection.setAttribute('aria-hidden', 'true');
            gsap.killTweensOf([searchRecentSection].concat(recentParts));
            gsap
              .timeline({
                onComplete: function () {
                  renderRecentSearches();
                  searchRecentSection.removeAttribute('aria-hidden');
                  searchRecentClear.disabled = false;
                  gsap.set([searchRecentSection].concat(recentParts), {
                    clearProps:
                      'height,marginBottom,opacity,overflow,pointerEvents,transform',
                  });
                },
              })
              .to(
                recentParts,
                {
                  opacity: 0,
                  y: -4,
                  duration: motionDurFast,
                  ease: 'power1.in',
                  stagger: 0.02,
                },
                0
              )
              .to(
                searchRecentSection,
                {
                  height: 0,
                  marginBottom: -parentGap,
                  opacity: 0,
                  overflow: 'hidden',
                  pointerEvents: 'none',
                  duration: motionDur,
                  ease: 'power2.inOut',
                },
                0
              );
          }

          if (searchAnnounce)
            searchAnnounce.textContent = 'Recent searches cleared';
          if (searchInput) searchInput.focus();
        });
      }

      function updateSearchScrolledState() {
        if (!searchScroll) return;
        searchDrawer.toggleAttribute(
          'data-search-scrolled',
          searchScroll.scrollTop > 0
        );
      }

      function setSearchOrigin(origin, context, trigger, level) {
        searchDrawer.setAttribute('data-search-origin', origin);
        if (context) {
          searchDrawer.setAttribute('data-search-origin-context', context);
        } else {
          searchDrawer.removeAttribute('data-search-origin-context');
        }
        if (level) {
          searchDrawer.setAttribute('data-search-origin-level', level);
        } else {
          searchDrawer.removeAttribute('data-search-origin-level');
        }
        searchOriginTrigger = trigger || null;
        if (searchBack) searchBack.hidden = false;
      }

      function clearSearchOrigin() {
        searchDrawer.removeAttribute('data-search-origin');
        searchDrawer.removeAttribute('data-search-origin-context');
        searchDrawer.removeAttribute('data-search-origin-level');
        searchOriginTrigger = null;
        if (searchBack) searchBack.hidden = true;
      }

      function clearSearchTransferStyles(deferMobileBackdropClear) {
        gsap.killTweensOf(searchTransferElements);
        gsap.set(searchTransferElements, {
          clearProps:
            'opacity,top,left,width,height,borderRadius,backgroundColor,backdropFilter,webkitBackdropFilter',
        });
        if (submenu) submenu.removeAttribute('data-drawer-transfer');
        if (mobileMenu) mobileMenu.removeAttribute('data-drawer-transfer');
        searchDrawer.removeAttribute('data-drawer-transfer');
        clearSearchRevealStyles();
        clearMobileBackdropTransfer(deferMobileBackdropClear);
      }

      function discardSearchTransfer() {
        if (!searchTransferTimeline) return;

        var origin = searchDrawer.getAttribute('data-search-origin');
        searchTransferTimeline.kill();
        searchTransferTimeline = null;
        clearSearchTransferStyles();

        if (origin === 'submenu') {
          resetDesktopDrawerState();
        } else if (origin === 'mobile-menu') {
          resetMobileMenuState();
        }
      }

      function completeSearchTransferReverse() {
        var origin = searchDrawer.getAttribute('data-search-origin');
        var context = searchDrawer.getAttribute('data-search-origin-context');
        var focusTarget = searchOriginTrigger;

        searchDrawer.setAttribute('data-search-state', 'closed');
        searchDrawer.setAttribute('aria-hidden', 'true');
        searchDrawer.removeAttribute('data-search-scrolled');
        [searchTrigger]
          .concat(searchMobileTriggers)
          .filter(Boolean)
          .forEach(function (trigger) {
            trigger.setAttribute('aria-expanded', 'false');
          });
        nav.removeAttribute('data-nav-search-fade');

        if (origin === 'submenu' && submenu) {
          submenu.setAttribute('data-submenu-state', 'open');
          submenu.setAttribute('aria-hidden', 'false');
          nav.setAttribute('data-nav-shared-fade', '');
          toggleBtns.forEach(function (btn) {
            btn.setAttribute(
              'aria-expanded',
              String(btn.getAttribute('data-nav-toggle') === context)
            );
          });
          isolateModal(submenu);
        } else if (origin === 'mobile-menu' && mobileMenu) {
          mobileMenu.setAttribute('data-mobile-menu-state', 'open');
          mobileMenu.setAttribute('aria-hidden', 'false');
          if (hamburger) hamburger.setAttribute('aria-expanded', 'true');
          isolateModal(mobileMenu);
        }

        clearSearchTransferStyles(origin === 'mobile-menu');
        if (searchTransferTimeline) searchTransferTimeline.kill();
        searchTransferTimeline = null;
        if (searchInput) searchInput.value = '';
        updateSearchQueryState();
        resetSearchResults();
        searchOpenTrigger = null;
        clearSearchOrigin();

        window.setTimeout(function () {
          if (focusTarget && focusTarget.isConnected) {
            focusTarget.focus({ preventScroll: true });
          }
        }, 0);
      }

      function resetSearchDrawerState() {
        if (!searchDrawer) return;
        if (searchDrawer.getAttribute('data-search-state') !== 'closed') {
          recordCompletedSearch();
        }
        if (searchTransferTimeline) {
          searchTransferTimeline.kill();
          searchTransferTimeline = null;
        }
        if (searchCloseTimer) {
          clearTimeout(searchCloseTimer);
          searchCloseTimer = null;
        }
        stopSearchReveal();
        gsap.killTweensOf(searchTransferElements);
        gsap.set(searchTransferElements, {
          clearProps:
            'opacity,top,left,width,height,borderRadius,backgroundColor,backdropFilter,webkitBackdropFilter',
        });
        if (submenu) submenu.removeAttribute('data-drawer-transfer');
        if (mobileMenu) mobileMenu.removeAttribute('data-drawer-transfer');
        searchDrawer.removeAttribute('data-drawer-transfer');
        clearMobileBackdropTransfer();
        searchDrawer.removeAttribute('data-search-scrolled');
        clearSearchOrigin();
        if (searchInput) searchInput.value = '';
        updateSearchQueryState();
        resetSearchResults();
        searchDrawer.setAttribute('data-search-state', 'closed');
        searchDrawer.setAttribute('aria-hidden', 'true');
        [searchTrigger]
          .concat(searchMobileTriggers)
          .filter(Boolean)
          .forEach(function (trigger) {
            trigger.setAttribute('aria-expanded', 'false');
          });
        nav.removeAttribute('data-nav-search-fade');
        searchOpenTrigger = null;
        searchNavigating = false;
      }

      function completeSubmenuSearchTransfer() {
        searchDrawer.setAttribute('data-search-state', 'open');
        searchDrawer.setAttribute('aria-hidden', 'false');
        window.setTimeout(function () {
          if (
            searchInput &&
            searchDrawer.getAttribute('data-search-state') === 'open' &&
            document.activeElement !== searchInput
          ) {
            searchInput.focus();
          }
        }, 0);
      }

      function transferSubmenuToSearch(trigger) {
        if (searchTransferTimeline) return;

        var emptyDuration = reducedMotion ? 0 : 0.14;
        var morphDuration = reducedMotion ? 0 : 0.32;
        var sharedDuration = reducedMotion ? 0 : 0.16;
        var morphStart = reducedMotion ? 0 : 0.04;
        var contentStart = reducedMotion ? 0 : 0.23;
        var sharedStart = reducedMotion ? 0 : 0.16;
        var closeStart = reducedMotion ? 0 : morphStart + morphDuration - 0.04;

        searchOpenTrigger = searchTrigger;
        setSearchOrigin(
          'submenu',
          submenu.getAttribute('data-context'),
          trigger,
          activeL2 ? activeL2.getAttribute('data-l2') : null
        );
        submenu.setAttribute('data-drawer-transfer', '');
        searchDrawer.setAttribute('data-drawer-transfer', '');
        submenu.setAttribute('data-submenu-state', 'closing');
        submenu.setAttribute('aria-hidden', 'true');
        searchDrawer.setAttribute('data-search-state', 'open');
        searchDrawer.setAttribute('aria-hidden', 'false');
        searchTrigger.setAttribute('aria-expanded', 'true');
        toggleBtns.forEach(function (btn) {
          btn.setAttribute('aria-expanded', 'false');
        });
        nav.removeAttribute('data-nav-shared-fade');
        nav.setAttribute('data-nav-search-fade', '');
        isolateModal(searchDrawer);

        var submenuRect = drawer.getBoundingClientRect();
        var searchRect = searchPanel.getBoundingClientRect();

        gsap.killTweensOf(searchTransferElements);
        gsap.set(
          [
            drawer,
            submenuLogo,
            submenuActions,
            submenuToggleGroup,
            submenuClose,
            submenuNav,
          ].filter(Boolean),
          { opacity: 1 }
        );
        gsap.set(searchPanel, {
          width: submenuRect.width,
          backgroundColor: 'transparent',
          opacity: 1,
        });
        gsap.set(drawer, {
          width: submenuRect.width,
        });
        gsap.set([searchLogo, searchClose].filter(Boolean), {
          opacity: 0,
        });

        requestAnimationFrame(function () {
          if (searchInput) searchInput.focus();
        });

        searchTransferTimeline = gsap.timeline({
          paused: true,
          defaults: { ease: 'power1.out' },
          onComplete: completeSubmenuSearchTransfer,
          onReverseComplete: completeSearchTransferReverse,
        });
        addSearchReveal(searchTransferTimeline, contentStart);

        if (submenuNav) {
          searchTransferTimeline.to(
            submenuNav,
            { opacity: 0, duration: emptyDuration },
            0
          );
        }
        if (submenuToggleGroup) {
          searchTransferTimeline.to(
            submenuToggleGroup,
            { opacity: 0, duration: emptyDuration },
            0
          );
        }
        if (drawer && searchPanel) {
          searchTransferTimeline.to(
            [drawer, searchPanel],
            {
              width: searchRect.width,
              duration: morphDuration,
              ease: 'power1.inOut',
            },
            morphStart
          );
        }
        if (submenuLogo) {
          searchTransferTimeline.to(
            submenuLogo,
            { opacity: 0, duration: sharedDuration },
            sharedStart
          );
        }
        if (searchLogo) {
          searchTransferTimeline.to(
            searchLogo,
            { opacity: 1, duration: sharedDuration },
            sharedStart
          );
        }
        if (submenuClose) {
          searchTransferTimeline.to(
            submenuClose,
            { opacity: 0, duration: emptyDuration },
            0
          );
        }
        if (searchClose) {
          searchTransferTimeline.to(
            searchClose,
            { opacity: 1, duration: sharedDuration },
            closeStart
          );
        }

        playSearchTransferAfterPaint(searchTransferTimeline);
      }

      function completeMobileMenuSearchTransfer() {
        searchDrawer.setAttribute('data-search-state', 'open');
        searchDrawer.setAttribute('aria-hidden', 'false');
        playSearchReveal(0);
        window.setTimeout(function () {
          if (
            searchInput &&
            searchDrawer.getAttribute('data-search-state') === 'open' &&
            document.activeElement !== searchInput
          ) {
            searchInput.focus();
          }
        }, 0);
      }

      function transferMobileMenuToSearch(trigger) {
        if (searchTransferTimeline || !mobileMenu || !mobilePanel) return;

        var emptyDuration = reducedMotion ? 0 : 0.15;
        var backdropDuration = reducedMotion ? 0 : 0.3;
        var backdropStart = reducedMotion ? 0 : 0.12;
        var panelStart = reducedMotion ? 0 : 0.37;
        var mobileRect = mobilePanel.getBoundingClientRect();
        var searchRect = searchPanel.getBoundingClientRect();
        var mobileStyles = window.getComputedStyle(mobilePanel);
        var searchStyles = window.getComputedStyle(searchPanel);
        var searchBackgroundColor = searchStyles.backgroundColor;
        var searchBorderRadius = searchStyles.borderRadius;

        searchOpenTrigger = nav.querySelector('[data-nav-search-mobile]');
        setSearchOrigin(
          'mobile-menu',
          mobileMenu.getAttribute('data-mobile-menu-context'),
          trigger,
          activeMobileL2 ? activeMobileL2.getAttribute('data-mobile-l2') : null
        );

        function openSearchWithoutTransfer() {
          resetMobileMenuState();
          searchDrawer.setAttribute('data-search-state', 'open');
          searchDrawer.setAttribute('aria-hidden', 'false');
          [searchTrigger]
            .concat(searchMobileTriggers)
            .filter(Boolean)
            .forEach(function (item) {
              item.setAttribute('aria-expanded', 'true');
            });
          isolateModal(searchDrawer);
          playSearchReveal(reducedMotion ? 0 : 0.16);
          if (searchInput) searchInput.focus();
        }

        if (reducedMotion) {
          openSearchWithoutTransfer();
          return;
        }

        var backdropTarget = prepareMobileBackdropTransfer(
          mobileRect,
          mobileStyles
        );
        if (!backdropTarget) {
          openSearchWithoutTransfer();
          return;
        }

        mobileMenu.setAttribute('data-drawer-transfer', '');
        searchDrawer.setAttribute('data-drawer-transfer', '');
        mobileMenu.setAttribute('data-mobile-menu-state', 'closing');
        mobileMenu.setAttribute('aria-hidden', 'true');
        searchDrawer.setAttribute('data-search-state', 'open');
        searchDrawer.setAttribute('aria-hidden', 'false');
        if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
        [searchTrigger]
          .concat(searchMobileTriggers)
          .filter(Boolean)
          .forEach(function (item) {
            item.setAttribute('aria-expanded', 'true');
          });
        isolateModal(searchDrawer);
        if (searchInput) searchInput.focus();

        if (mobileDrillTimeline) {
          mobileDrillTimeline.kill();
          mobileDrillTimeline = null;
          mobileDrilling = false;
        }
        if (mobileContextTimeline) {
          mobileContextTimeline.kill();
          mobileContextTimeline = null;
          mobileContextSwitching = false;
        }

        shareMobileMenuLogoWithSearch();
        gsap.killTweensOf(searchTransferElements);
        gsap.set(
          [
            mobilePanel,
            mobileMenuHeading,
            mobileMenuLogo,
            mobileMenuClose,
            mobileMenuToggleWrap,
            mobileMenuNav,
            mobileMenuUtility,
          ].filter(Boolean),
          { opacity: 1 }
        );
        gsap.set(searchPanel, {
          top: mobileRect.top,
          left: mobileRect.left,
          width: mobileRect.width,
          height: mobileRect.height,
          borderRadius: mobileStyles.borderRadius,
          backgroundColor: 'transparent',
          opacity: 1,
        });
        gsap.set(searchBody, { opacity: 0 });
        if (mobileMenuClose) gsap.set(mobileMenuClose, { opacity: 0 });
        if (searchClose) gsap.set(searchClose, { opacity: 1 });

        searchTransferTimeline = gsap.timeline({
          paused: true,
          defaults: { ease: 'power1.out' },
          onComplete: completeMobileMenuSearchTransfer,
          onReverseComplete: completeSearchTransferReverse,
        });

        searchTransferTimeline.to(
          [mobileMenuToggleWrap, mobileMenuNav, mobileMenuUtility].filter(
            Boolean
          ),
          { opacity: 0, duration: emptyDuration },
          0
        );
        searchTransferTimeline.call(
          function () {
            var isReversing = searchTransferTimeline.reversed();
            gsap.set(mobileTransferBackdrop, {
              opacity: isReversing ? 0 : 1,
            });
            gsap.set(mobilePanel, { opacity: isReversing ? 1 : 0 });
          },
          null,
          backdropStart
        );
        searchTransferTimeline.to(
          mobileTransferBackdrop,
          {
            clipPath: 'inset(0px round 0px)',
            backgroundColor: backdropTarget.backgroundColor,
            backdropFilter: backdropTarget.backdropFilter,
            webkitBackdropFilter: backdropTarget.webkitBackdropFilter,
            duration: backdropDuration,
            ease: 'power2.inOut',
          },
          backdropStart
        );
        searchTransferTimeline.to(
          searchPanel,
          {
            top: searchRect.top,
            left: searchRect.left,
            width: searchRect.width,
            height: searchRect.height,
            borderRadius: searchBorderRadius,
            duration: backdropDuration,
            ease: 'power2.inOut',
          },
          backdropStart
        );
        searchTransferTimeline.to(
          searchPanel,
          {
            backgroundColor: searchBackgroundColor,
            duration: reducedMotion ? 0 : 0.25,
          },
          panelStart
        );

        playSearchTransferAfterPaint(searchTransferTimeline);
      }

      function openSearchDrawer(trigger) {
        if (searchCloseTimer) {
          clearTimeout(searchCloseTimer);
          searchCloseTimer = null;
        }
        clearSearchOrigin();
        if (searchScroll) {
          searchScroll.scrollTop = 0;
          updateSearchScrolledState();
        }

        var isMobileSearch = window.innerWidth < 768;
        if (isMobileSearch) {
          if (
            mobileMenu &&
            mobileMenu.getAttribute('data-mobile-menu-state') === 'open' &&
            trigger &&
            trigger.closest('[data-mobile-menu]')
          ) {
            transferMobileMenuToSearch(trigger);
            return;
          }
          if (
            mobileMenu &&
            mobileMenu.getAttribute('data-mobile-menu-state') !== 'closed'
          ) {
            resetMobileMenuState();
          }
          searchOpenTrigger =
            trigger && trigger.closest('[data-mobile-menu]')
              ? nav.querySelector('[data-nav-search-mobile]')
              : trigger;
          searchDrawer.setAttribute('data-search-state', 'open');
          searchDrawer.setAttribute('aria-hidden', 'false');
          [searchTrigger]
            .concat(searchMobileTriggers)
            .filter(Boolean)
            .forEach(function (item) {
              item.setAttribute('aria-expanded', 'true');
            });
          isolateModal(searchDrawer);
          playSearchReveal(reducedMotion ? 0 : 0.16);
          requestAnimationFrame(function () {
            if (searchInput) searchInput.focus();
          });
          return;
        }

        var fromSubmenu = trigger && trigger.closest('[data-submenu]');
        if (
          fromSubmenu &&
          submenu &&
          submenu.getAttribute('data-submenu-state') === 'open'
        ) {
          transferSubmenuToSearch(trigger);
          return;
        }

        if (submenu && submenu.getAttribute('data-submenu-state') === 'open') {
          closeDrawer();
        }

        searchOpenTrigger = fromSubmenu
          ? searchTrigger
          : trigger || searchTrigger;
        searchDrawer.setAttribute('data-search-state', 'open');
        searchDrawer.setAttribute('aria-hidden', 'false');
        [searchTrigger]
          .concat(searchMobileTriggers)
          .filter(Boolean)
          .forEach(function (item) {
            item.setAttribute('aria-expanded', 'true');
          });
        nav.setAttribute('data-nav-search-fade', '');
        isolateModal(searchDrawer);
        playSearchReveal(reducedMotion ? 0 : 0.3);

        requestAnimationFrame(function () {
          if (searchInput) searchInput.focus();
        });
      }

      function closeSearchDrawer(restoreFocus) {
        discardSearchTransfer();
        stopSearchReveal();
        if (searchCloseTimer) return;
        recordCompletedSearch();
        resetSearchProducts();
        searchDrawer.setAttribute('data-search-state', 'closing');
        searchDrawer.setAttribute('aria-hidden', 'true');
        clearSearchOrigin();
        [searchTrigger]
          .concat(searchMobileTriggers)
          .filter(Boolean)
          .forEach(function (trigger) {
            trigger.setAttribute('aria-expanded', 'false');
          });
        nav.removeAttribute('data-nav-search-fade');
        clearModalIsolation();

        searchCloseTimer = setTimeout(function () {
          searchDrawer.setAttribute('data-search-state', 'closed');
          searchCloseTimer = null;
          if (!searchNavigating) {
            if (searchInput) searchInput.value = '';
            updateSearchQueryState();
            resetSearchResults();
          }
        }, 280);

        if (restoreFocus !== false && searchOpenTrigger) {
          searchOpenTrigger.focus();
          searchOpenTrigger = null;
        }
      }

      function returnToSearchOrigin() {
        var origin = searchDrawer.getAttribute('data-search-origin');
        if (!origin) return;

        if (searchTransferTimeline) {
          recordCompletedSearch();
          if (origin === 'mobile-menu') {
            stopSearchReveal();
            if (searchBody) gsap.set(searchBody, { opacity: 1 });
          }
          searchDrawer.setAttribute('data-search-state', 'closing');
          searchDrawer.setAttribute('aria-hidden', 'true');
          if (searchBody) {
            gsap.to(searchBody, {
              opacity: 0,
              duration: reducedMotion ? 0 : 0.14,
              ease: 'power1.out',
            });
          }
          var reverseTargetDuration = reducedMotion
            ? 0
            : origin === 'mobile-menu'
              ? 0.4
              : 0.28;
          var transferDuration = searchTransferTimeline.duration();
          searchTransferTimeline.timeScale(
            reverseTargetDuration && transferDuration > reverseTargetDuration
              ? transferDuration / reverseTargetDuration
              : 1
          );
          searchTransferTimeline.reverse();
          return;
        }

        var context =
          searchDrawer.getAttribute('data-search-origin-context') ||
          nav.getAttribute('data-nav-context') ||
          'shop';
        var level = searchDrawer.getAttribute('data-search-origin-level');
        var originTrigger = searchOriginTrigger;
        var returnToMobileMenu = window.innerWidth < 768;
        var focusTarget = originTrigger;

        closeSearchDrawer(false);
        searchOpenTrigger = null;

        window.requestAnimationFrame(function () {
          if (returnToMobileMenu && mobileMenu && hamburger) {
            mobileMenu.setAttribute('data-mobile-menu-context', context);
            nav.setAttribute('data-nav-context', context);
            mobileMenu
              .querySelectorAll('[data-mobile-menu-toggle]')
              .forEach(function (toggle) {
                toggle.setAttribute(
                  'aria-pressed',
                  String(
                    toggle.getAttribute('data-mobile-menu-toggle') === context
                  )
                );
              });
            if (!focusTarget || !focusTarget.closest('[data-mobile-menu]')) {
              focusTarget = mobileMenu.querySelector(
                '[data-mobile-menu-search]'
              );
            }
            hamburger.click();
            if (level) {
              var mobileLevelTrigger = mobileMenu.querySelector(
                '[data-mobile-l1="' + level + '"]'
              );
              if (mobileLevelTrigger) mobileLevelTrigger.click();
            }
          } else {
            var drawerTrigger = nav.querySelector(
              '[data-nav-toggle="' + context + '"]'
            );
            if (!focusTarget || !focusTarget.closest('[data-submenu]')) {
              focusTarget = submenu
                ? submenu.querySelector('[data-submenu-search]')
                : null;
            }
            if (drawerTrigger) drawerTrigger.click();
            if (level && submenu) {
              var drawerLevelTrigger = submenu.querySelector(
                '[data-l1="' + level + '"][data-has-l2]'
              );
              if (drawerLevelTrigger) drawerLevelTrigger.click();
            }
          }

          window.setTimeout(function () {
            if (focusTarget && focusTarget.isConnected) {
              focusTarget.focus({ preventScroll: true });
            }
          }, 0);
        });
      }

      function updateSearchLinks(query) {
        var searchUrl = searchForm
          ? searchForm.action
          : '{{ routes.search_url }}';
        if (searchViewAll) {
          searchViewAll.href = searchUrl + '?q=' + encodeURIComponent(query);
        }
        if (searchFooterHint) {
          searchFooterHint.textContent = 'or press enter';
        }
      }

      function renderSearchResponse(
        markup,
        query,
        clickedSuggestion,
        requestId
      ) {
        if (requestId !== searchRequestSequence) return;
        if (
          normalizeSearchText(searchInput ? searchInput.value : '') !==
          normalizeSearchText(query)
        ) {
          return;
        }
        var documentFragment = new DOMParser().parseFromString(
          markup,
          'text/html'
        );
        var response = documentFragment.querySelector('[data-search-response]');
        var suggestionGroup = response
          ? response.querySelector('[data-search-results-group="suggestions"]')
          : null;
        if (clickedSuggestion && suggestionGroup) {
          suggestionGroup.remove();
        } else if (suggestionGroup) {
          var normalizedQuery = normalizeSearchText(query);
          var renderedSuggestionCount = 0;
          suggestionGroup
            .querySelectorAll('[data-search-suggestion]')
            .forEach(function (suggestion) {
              var suggestionValue =
                suggestion.getAttribute('data-search-suggestion-value') || '';
              var isDuplicate =
                normalizeSearchText(suggestionValue) === normalizedQuery;
              if (isDuplicate || renderedSuggestionCount >= 3) {
                suggestion.remove();
                return;
              }
              renderedSuggestionCount += 1;
            });
          if (!suggestionGroup.querySelector('[data-search-suggestion]')) {
            suggestionGroup.remove();
          }
        }
        var suggestionCount = response
          ? response.querySelectorAll('[data-search-suggestion]').length
          : 0;
        var actionableCount = response
          ? response.querySelectorAll('[data-search-result-link]').length
          : 0;
        var totalCount = suggestionCount + actionableCount;
        var footerWasVisible =
          searchFooter &&
          window.getComputedStyle(searchFooter).display !== 'none';
        stopSearchLoading();

        if (searchPredictive) {
          searchPredictive.innerHTML = '';
          if (response) searchPredictive.appendChild(response);
        }
        initialiseSearchProductImages(response);

        if (searchQueryLabel) searchQueryLabel.textContent = query;
        searchDrawer.toggleAttribute(
          'data-search-has-results',
          actionableCount > 0
        );
        if (!searchInfiniteProducts) updateSearchLinks(query);
        searchHasRenderedResults = totalCount > 0;

        if (response) {
          response.setAttribute('data-search-result-count', String(totalCount));
          response.setAttribute(
            'data-search-actionable-count',
            String(actionableCount)
          );
        }

        if (totalCount > 0) {
          setSearchView(
            clickedSuggestion ? 'clicked' : 'autocomplete',
            false,
            function () {
              if (
                !searchInfiniteProducts &&
                actionableCount > 0 &&
                !footerWasVisible
              ) {
                revealSearchFooter();
              }
            }
          );
          if (searchAnnounce) {
            searchAnnounce.textContent =
              totalCount +
              ' ' +
              (totalCount === 1 ? 'result' : 'results') +
              ' available';
