      var mobileMenuNav = mobileMenu
        ? mobileMenu.querySelector('.v3-mobile-menu__nav')
        : null;
      var mobileMenuUtility = mobileMenu
        ? mobileMenu.querySelector('.v3-mobile-menu__utility')
        : null;
      var searchCloseTimer = null;
      var searchDebounceTimer = null;
      var searchLoadingTimer = null;
      var searchRequest = null;
      var searchRequestSequence = 0;
      var searchCompletedRequestId = 0;
      var searchCompletedQuery = '';
      var searchCompletedHasResults = false;
      var searchCache = new Map();
      var searchProductsRequest = null;
      var searchProductsObserver = null;
      var searchProductsQuery = '';
      var searchProductsPage = 0;
      var searchProductsPages = 0;
      var searchProductsCount = 0;
      var searchProductsRetryPage = null;
      var searchProductsLoading = false;
      var searchProductsClickedSuggestion = false;
      var searchHasRenderedResults = false;
      var searchLoadingPreview =
