          if (context === currentContext) return;
          if (mobileContextSwitching) return;

          mobileContextSwitching = true;
          updateMobileToggle(context);

          var fadeOutTarget = activeMobileL2 || mobileL1View;
          var utilityLinks = Array.from(
            mobileMenu.querySelectorAll('.v3-mobile-menu__utility-links')
