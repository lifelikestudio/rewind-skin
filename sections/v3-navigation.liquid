      var submenuActions = submenu
        ? submenu.querySelector('.v3-submenu__actions')
        : null;
      var submenuToggleGroup = submenu
        ? submenu.querySelector('[data-submenu-toggle-group]')
        : null;
      var submenuClose = submenu
        ? submenu.querySelector('[data-submenu-close]')
        : null;
      var submenuNav = submenu
        ? submenu.querySelector('.v3-submenu__nav')
        : null;
      var mobileMenuHeading = mobileMenu
