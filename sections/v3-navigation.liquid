          </svg>
        {%- endif -%}
      </a>

      {%- comment -%} PriorityLinks {%- endcomment -%}
      <div class='group/priority flex items-center gap-[8px]'>
        {%- comment -%} Shop/Studio toggle (MainPathsGroup) {%- endcomment -%}
        <div
          class='bg-rest rounded-pill relative flex items-center gap-[4px] p-[4px]'
          role='group'
          aria-label='{{ 'sections.v3_navigation.navigation_context' | t | escape }}'
          data-nav-paths
        >
          <span
            class='v3-nav__slider rounded-pill bg-hover pointer-events-none absolute top-[4px] h-[calc(100%_-_8px)] opacity-0'
            aria-hidden='true'
          ></span>
          <button
            type='button'
            class='v3-nav__switch-btn rounded-pill text-nav-label font-base text-ink relative z-[1] h-[30px] px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
            data-nav-toggle='shop'
            aria-expanded='false'
            aria-controls='v3-submenu-{{ section.id }}'
          >
            {{ section.settings.shop_label | default: 'Shop' }}
          </button>
          <button
            type='button'
            class='v3-nav__switch-btn rounded-pill text-nav-label font-base text-ink relative z-[1] h-[30px] px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
            data-nav-toggle='studio'
            aria-expanded='false'
            aria-controls='v3-submenu-{{ section.id }}'
          >
            {{ section.settings.studio_label | default: 'Studio' }}
          </button>
        </div>

        {%- comment -%} Search pill (NavBtnIcon) {%- endcomment -%}
        {%- if section.settings.show_search -%}
          <button
            type='button'
            class='v3-nav__search-pill bg-rest rounded-pill flex h-[38px] items-center gap-[8px] pr-[5px] pl-[18px] transition-colors duration-150 ease-out lg:h-[40px] lg:pr-[6px]'
            aria-label='{{ 'sections.v3_navigation.search' | t | escape }}'
            aria-expanded='false'
            aria-controls='v3-search-drawer-{{ section.id }}'
            data-nav-search
          >
            <span class='text-nav-label font-base text-ink tracking-tight transition-colors duration-150 ease-out'>
              {{- 'sections.v3_navigation.search' | t -}}
            </span>
            <span class='bg-hover rounded-pill flex h-[28px] w-[28px] items-center justify-center transition-colors duration-150 ease-out'>
              {%- render 'v3-icon-search',
                size: 11,
                class: 'w-[10px] lg:w-[11px] h-[10px] lg:h-[11px] text-ink'
              -%}
            </span>
          </button>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} SupportingLinks (right group) {%- endcomment -%}
    <div
      class='group/supporting flex items-center justify-end gap-[4px]'
      style='padding-right: calc(var(--v3-nav-pr-offset, 0px));'
    >
      {%- if section.settings.show_cart -%}
        <button
          type='button'
          class='v3-nav__naked-btn rounded-pill text-nav-label font-base text-ink flex h-[30px] items-center px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
          id='v3-cart-btn'
          aria-label='{{ cart_bag_label | escape }}{% if cart_count > 0 %}, {{ cart_count }} {{ cart_item_label | escape }}{% endif %}'
          aria-expanded='false'
          aria-controls='v3-cart-drawer'
          data-nav-cart
        >
          <span data-nav-cart-label>{{ cart_bag_label | escape }}</span>
          <span
            class='v3-nav__cart-count'
            data-nav-cart-count
            aria-hidden='true'
            {% if cart_count == 0 %}
              hidden
            {% endif %}
          >
            &nbsp;({{ cart_count_desktop }})</span
          >
        </button>
      {%- endif -%}

      {%- if section.settings.show_wishlist -%}
        <button
          type='button'
          class='v3-nav__naked-btn rounded-pill text-nav-label font-base text-ink flex h-[30px] items-center px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
          data-nav-wishlist
        >
          {{ 'sections.v3_navigation.wishlist' | t }}
        </button>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a
          href='{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}'
          class='v3-nav__naked-btn rounded-pill text-nav-label font-base text-ink flex h-[30px] items-center px-[14px] tracking-tight transition-colors duration-150 ease-out lg:h-[32px]'
        >
          {{ 'sections.v3_navigation.account' | t }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ═══ MOBILE (BELOW SM) ═══ {%- endcomment -%}
  <div
    class='
      xxs:h-[76px] xs:h-[80px] xxs:pl-[14px] xs:pl-[16px]
      xxs:pr-[11px] xs:pr-[12px] flex
      h-[76px] items-center justify-between
      pr-[11px] pl-[14px] sm:hidden
    '
  >
    {%- comment -%} Logotype {%- endcomment -%}
    <a
      href='{{ routes.root_url }}'
      class='block shrink-0'
      aria-label='{{ shop.name }}'
    >
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag:
            class: 'w-[165px] xxs:w-[179px] xs:w-[193px] h-auto',
            widths: '165, 179, 193, 330, 358, 386',
            alt: section.settings.logo.alt
          | default: shop.name
        }}
      {%- else -%}
        <svg
          class='xxs:w-[179px] xxs:h-[13px] xs:w-[193px] xs:h-[14px] h-[12px] w-[165px] overflow-visible'
          viewBox='0 0 193.235 14'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
          aria-label='{{ shop.name }}'
          role='img'
        >
