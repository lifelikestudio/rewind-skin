<style>
  .v3-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    background: var(--color-overlay-light);
    backdrop-filter: blur(var(--blur-overlay));
    -webkit-backdrop-filter: blur(var(--blur-overlay));
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .v3-modal-backdrop[data-v3-modal-backdrop-open] {
    opacity: 1;
    transition-duration: 250ms;
  }

  .v3-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    font-family:
      'Scto Grotesk A',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      Oxygen-Sans,
      Ubuntu,
      Cantarell,
      'Helvetica Neue',
      sans-serif;
    font-weight: 400;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .v3-nav button,
  .v3-nav a,
  .v3-nav input {
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  /* Desktop: optical padding offset (right container padding is smaller,
     rightmost link's internal padding makes text edge align with left) */
  .v3-nav > div:first-child {
    --v3-nav-pr-offset: 0px;
    padding-right: 6px;
  }
  @media (min-width: 768px) {
    .v3-nav > div:first-child {
      padding-right: 6px;
    }
  }
  @media (min-width: 1024px) {
    .v3-nav > div:first-child {
      padding-right: 10px;
    }
  }
  @media (min-width: 1280px) {
    .v3-nav > div:first-child {
      padding-right: 10px;
    }
  }
  @media (min-width: 1440px) {
    .v3-nav > div:first-child {
      padding-right: 18px;
    }
  }
  @media (min-width: 1920px) {
    .v3-nav > div:first-child {
      padding-right: 26px;
    }
  }

  /* ═══ PRESSED STATES (all input types) ═══ */

  .v3-nav__switch-btn:active {
    background-color: var(--color-bg);
  }
  .v3-nav__search-pill:active {
    background-color: var(--color-pressed);
  }
  .v3-nav__search-pill:active > span:last-child {
    background-color: var(--color-rest);
  }
  .v3-nav__naked-btn:active {
    background-color: var(--color-pressed);
  }

  /* ═══ HOVER STATES (pointer devices only) ═══ */

  @media (hover: hover) {
    .v3-nav__switch-btn {
      transition:
        color 150ms ease-out 200ms,
        background-color 150ms ease-out;
    }

    .v3-nav__search-pill {
      transition: background-color 150ms ease-out;
    }
    .v3-nav__search-pill span:first-child {
      transition: color 150ms ease-out 200ms;
    }

    .v3-nav__search-pill:hover {
      background-color: var(--color-hover);
    }
    .v3-nav__search-pill:hover > span:last-child {
      background-color: var(--color-rest);
    }

    .v3-nav__naked-btn {
      transition:
        color 150ms ease-out 200ms,
        background-color 150ms ease-out;
    }
    .v3-nav__naked-btn:hover {
      background-color: var(--color-rest);
    }

    /* Demote siblings — supporting group */
    .group\/supporting:has(.v3-nav__naked-btn:hover) .v3-nav__naked-btn {
      color: var(--color-muted);
      transition:
        color 150ms ease-out,
        background-color 150ms ease-out;
    }
    .group\/supporting:has(.v3-nav__naked-btn:hover) .v3-nav__naked-btn:hover {
      color: var(--color-ink);
    }

    /* Demote siblings — priority group */
    .group\/priority:has(.v3-nav__switch-btn:hover, .v3-nav__search-pill:hover)
      .v3-nav__switch-btn,
    .group\/priority:has(.v3-nav__switch-btn:hover, .v3-nav__search-pill:hover)
      .v3-nav__search-pill
      span:first-child {
      color: var(--color-muted);
      transition: color 150ms ease-out;
    }
    .group\/priority:has(.v3-nav__switch-btn:hover, .v3-nav__search-pill:hover)
      .v3-nav__switch-btn:hover,
    .group\/priority:has(.v3-nav__switch-btn:hover, .v3-nav__search-pill:hover)
      .v3-nav__search-pill:hover
      span:first-child {
      color: var(--color-ink);
    }
  }

  /* ═══ FOCUS FALLBACKS — mirror hover feedback where no focus state exists ═══ */
  .v3-nav__search-pill:focus-visible {
    background-color: var(--color-hover);
  }
  .v3-nav__search-pill:focus-visible > span:last-child {
    background-color: var(--color-rest);
  }
  .v3-nav__naked-btn:focus-visible {
    background-color: var(--color-rest);
  }

  .group\/supporting:has(.v3-nav__naked-btn:focus-visible) .v3-nav__naked-btn {
    color: var(--color-muted);
  }
  .group\/supporting:has(.v3-nav__naked-btn:focus-visible)
    .v3-nav__naked-btn:focus-visible {
    color: var(--color-ink);
  }

  .group\/priority:has(
      .v3-nav__switch-btn:focus-visible,
      .v3-nav__search-pill:focus-visible
    )
    .v3-nav__switch-btn,
  .group\/priority:has(
      .v3-nav__switch-btn:focus-visible,
      .v3-nav__search-pill:focus-visible
    )
    .v3-nav__search-pill
    span:first-child {
    color: var(--color-muted);
  }
  .group\/priority:has(
      .v3-nav__switch-btn:focus-visible,
      .v3-nav__search-pill:focus-visible
    )
    .v3-nav__switch-btn:focus-visible,
  .group\/priority:has(
      .v3-nav__switch-btn:focus-visible,
      .v3-nav__search-pill:focus-visible
    )
    .v3-nav__search-pill:focus-visible
    span:first-child {
    color: var(--color-ink);
  }

  /* ═══ MOBILE: cart badge ═══
     Capsize trim pseudos (display: table) become flex items inside the
     badge pill and fight against flex centering. Disable them here —
     the badge uses flexbox for vertical alignment, not text flow. */
  .v3-nav__cart-badge {
    top: 0;
    right: 0;
    transform: translate(50%, -50%) scale(0.923);
  }
  .v3-nav__cart-badge[hidden],
  .v3-nav__cart-count[hidden] {
    display: none;
  }
  .v3-nav__cart-badge-content {
    display: inline-flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding-top: 1px;
  }
  @media (min-width: 375px) {
    .v3-nav__cart-badge {
      transform: translate(50%, -50%) scale(0.962);
    }
  }
  @media (min-width: 428px) {
    .v3-nav__cart-badge {
      transform: translate(50%, -50%) scale(1);
    }
  }
  .v3-nav__cart-badge::before,
  .v3-nav__cart-badge::after,
  .v3-nav__cart-badge-content::before,
  .v3-nav__cart-badge-content::after {
    display: none;
  }

  /* ═══ MOBILE: hamburger spacing + pressed ═══
     Left margin compensates for cart touch-target padding so the visual
     gap between icon edge and pill edge matches the design (14/15/16px).
     Declared here (unlayered) because global.css `button { margin: 0 }`
     beats Tailwind utilities living in @layer utilities. */
  .v3-nav__hamburger {
    margin-left: 4px;
  }
  @media (min-width: 375px) {
    .v3-nav__hamburger {
      margin-left: 3.5px;
    }
  }
  @media (min-width: 428px) {
    .v3-nav__hamburger {
      margin-left: 3px;
    }
  }
  .v3-nav__hamburger:active {
    background-color: var(--color-pressed);
  }

  /* ═══ VISITED LINKS ═══ */
  .v3-nav a,
  .v3-nav a:visited {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* ═══ FOCUS VISIBLE ═══ */
  .v3-nav button:focus-visible,
  .v3-nav a:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
    border-radius: 9999px;
  }

  /* ═══ TIER 2: DRAWER HAND-OFFS ═══
     The logo fades whenever its drawer counterpart appears. The path toggle
     only fades for the submenu, where the same controls reappear. */
  .v3-nav [data-nav-logo],
  .v3-nav [data-nav-paths] {
    transition: opacity 200ms ease-out;
  }
  .v3-nav[data-nav-shared-fade] [data-nav-logo],
  .v3-nav[data-nav-search-fade] [data-nav-logo],
  .v3-nav[data-nav-shared-fade] [data-nav-paths] {
    opacity: 0;
    pointer-events: none;
  }

  /* Modal-to-modal transfer is orchestrated by GSAP. Disable the drawers'
     independent CSS transitions so the shared backdrop remains visually still. */
  .v3-submenu[data-drawer-transfer] .v3-submenu__drawer,
  .v3-submenu[data-drawer-transfer] .v3-submenu__heading > a,
  .v3-submenu[data-drawer-transfer] .v3-submenu__actions,
  .v3-submenu[data-drawer-transfer] .v3-submenu__nav,
  .v3-mobile-menu[data-drawer-transfer] .v3-mobile-menu__panel,
  .v3-mobile-menu[data-drawer-transfer] .v3-mobile-menu__heading,
  .v3-mobile-menu[data-drawer-transfer] .v3-mobile-menu__toggle-wrap,
  .v3-mobile-menu[data-drawer-transfer] .v3-mobile-menu__nav,
  .v3-mobile-menu[data-drawer-transfer] .v3-mobile-menu__utility,
  .v3-search[data-drawer-transfer] .v3-search__drawer,
  .v3-search[data-drawer-transfer] .v3-search__logo,
  .v3-search[data-drawer-transfer] .v3-search__close,
  .v3-search[data-drawer-transfer] .v3-search__body {
    transition: none !important;
  }
  .v3-search[data-search-reveal] .v3-search__body {
    transition: none !important;
  }

  /* ═══ REDUCED MOTION ═══ */
  @media (prefers-reduced-motion: reduce) {
    .v3-modal-backdrop,
    .v3-nav,
    .v3-nav * {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  (function () {
    var nav = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!nav) return;

    var submenu = document.getElementById('v3-submenu-{{ section.id }}');
    var drawer = submenu ? submenu.querySelector('.v3-submenu__drawer') : null;
    var overlay = submenu
      ? submenu.querySelector('[data-submenu-overlay]')
      : null;
    var primary = submenu
      ? submenu.querySelector('[data-submenu-primary]')
      : null;
    var searchDrawer = document.getElementById(
      'v3-search-drawer-{{ section.id }}'
    );
    var searchTrigger = nav.querySelector('[data-nav-search]');
    var searchMobileTriggers = Array.from(
      document.querySelectorAll(
        '[data-section-id="{{ section.id }}"] [data-nav-search-mobile], #v3-mobile-menu-{{ section.id }} [data-mobile-menu-search]'
      )
    );
    var openTrigger = null;
    var modalCoordinator = window.RewindV3ModalCoordinator;

    if (!modalCoordinator) {
      modalCoordinator = (function () {
        var activeOwner = null;
        var activeUsesBackdrop = false;
        var backdropCloseFrame = null;
        var inertRecords = [];
        var previousOverflow = '';

        function getBackdrop() {
          return document.querySelector('[data-v3-modal-backdrop]');
        }

        function showBackdrop() {
          var backdrop = getBackdrop();
          if (backdropCloseFrame !== null) {
            window.cancelAnimationFrame(backdropCloseFrame);
            backdropCloseFrame = null;
          }
          if (backdrop) {
            backdrop.setAttribute('data-v3-modal-backdrop-open', '');
          }
        }

        function scheduleBackdropClose() {
          if (backdropCloseFrame !== null) {
            window.cancelAnimationFrame(backdropCloseFrame);
          }
          backdropCloseFrame = window.requestAnimationFrame(function () {
            var backdrop = getBackdrop();
            backdropCloseFrame = null;
            if ((!activeOwner || !activeUsesBackdrop) && backdrop) {
              backdrop.removeAttribute('data-v3-modal-backdrop-open');
            }
          });
        }

        function clearIsolation() {
          inertRecords.forEach(function (record) {
            if (record.wasInert) {
              record.element.inert = true;
            } else {
              record.element.inert = false;
              record.element.removeAttribute('inert');
            }
          });
          inertRecords = [];
        }

        function applyIsolation(activeRoot) {
          var branch = activeRoot;
          var parent = branch ? branch.parentElement : null;

          while (parent) {
            Array.from(parent.children).forEach(function (child) {
              if (child === branch) return;
              inertRecords.push({
                element: child,
                wasInert: child.inert || child.hasAttribute('inert'),
              });
              child.inert = true;
            });

            if (parent === document.body) break;
            branch = parent;
            parent = parent.parentElement;
          }
        }

        return {
          acquire: function (owner, activeRoot, options) {
            if (!owner || !activeRoot) return;

            if (activeOwner && activeOwner !== owner) {
              document.dispatchEvent(
                new CustomEvent('v3:modal-release-request', {
                  detail: { owner: activeOwner, nextOwner: owner },
                })
              );
            }

            if (activeOwner && activeOwner !== owner) {
              clearIsolation();
              document.documentElement.style.overflow = previousOverflow;
              activeOwner = null;
              activeUsesBackdrop = false;
            }

            if (activeOwner !== owner) {
              previousOverflow = document.documentElement.style.overflow;
              activeOwner = owner;
            } else {
              clearIsolation();
            }

            document.documentElement.style.overflow = 'hidden';
            applyIsolation(activeRoot);
            activeUsesBackdrop = !options || options.useBackdrop !== false;
            if (activeUsesBackdrop) {
              showBackdrop();
            } else {
              scheduleBackdropClose();
            }
          },
          refresh: function (owner, activeRoot) {
            if (activeOwner !== owner || !activeRoot) return;
            clearIsolation();
            applyIsolation(activeRoot);
          },
          release: function (owner) {
            if (activeOwner !== owner) {
              if (!activeOwner) scheduleBackdropClose();
              return false;
            }
            clearIsolation();
            document.documentElement.style.overflow = previousOverflow;
            activeOwner = null;
            activeUsesBackdrop = false;
            scheduleBackdropClose();
            return true;
          },
          getOwner: function () {
            return activeOwner;
          },
        };
      })();
      window.RewindV3ModalCoordinator = modalCoordinator;
    }

    /* Keep only the active modal branch exposed to keyboard and assistive
       technology, while preserving any inert states owned by the theme. */
    function isolateModal(activeRoot) {
      modalCoordinator.acquire('navigation', activeRoot, {
        useBackdrop: activeRoot !== mobileMenu,
      });
    }

    function clearModalIsolation() {
      modalCoordinator.release('navigation');
    }

    /* ═══ SHOP/STUDIO TOGGLE — opens/closes submenu drawer ═══ */
    var toggleBtns = nav.querySelectorAll('[data-nav-toggle]');
    toggleBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var context = btn.getAttribute('data-nav-toggle');
        var isOpen =
          submenu && submenu.getAttribute('data-submenu-state') === 'open';
        var currentContext = submenu
          ? submenu.getAttribute('data-context')
          : null;

        nav.setAttribute('data-nav-context', context);
        document.dispatchEvent(
          new CustomEvent('nav:context-change', {
            detail: { context: context },
          })
        );

        if (submenu) {
          if (isOpen && context === currentContext) {
            closeDrawer();
          } else {
            openTrigger = btn;
            openDrawer(context);
          }
        }
      });
    });

    /* ═══ SHOP/STUDIO HOVER SLIDER (pointer devices only) ═══ */
    var hasHover = window.matchMedia('(hover: hover)').matches;
    var reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    var pathsGroup = nav.querySelector('[data-nav-paths]');
    var slider = pathsGroup
      ? pathsGroup.querySelector('.v3-nav__slider')
      : null;

    if (hasHover && slider && toggleBtns.length) {
      var sliderActive = false;
      var fadeTimer = null;

      function positionSlider(btn, animate) {
        gsap.killTweensOf(slider);
        if (animate) {
          gsap.to(slider, {
            width: btn.offsetWidth,
            left: btn.offsetLeft,
            opacity: 1,
            duration: motionDur,
            ease: 'power1.out',
          });
        } else {
          gsap.set(slider, { width: btn.offsetWidth, left: btn.offsetLeft });
          gsap.to(slider, {
            opacity: 1,
            duration: motionDurFast,
            ease: 'power1.out',
          });
        }
      }

      function fadeSlider() {
        gsap.killTweensOf(slider);
        gsap.to(slider, {
          opacity: 0,
          duration: motionDurFast,
          ease: 'power1.out',
          onComplete: function () {
            gsap.set(slider, { clearProps: 'left,width,opacity' });
          },
        });
        sliderActive = false;
      }

      toggleBtns.forEach(function (btn) {
        btn.addEventListener('mouseenter', function () {
          if (fadeTimer) {
            clearTimeout(fadeTimer);
            fadeTimer = null;
          }
          positionSlider(btn, sliderActive);
          sliderActive = true;
        });

        btn.addEventListener('mouseleave', function (e) {
          if (
            e.relatedTarget &&
            e.relatedTarget.closest &&
            e.relatedTarget.closest('[data-nav-toggle]')
          )
            return;
          fadeTimer = setTimeout(fadeSlider, 200);
        });
      });

      pathsGroup.addEventListener('mouseleave', function () {
        if (fadeTimer) {
          clearTimeout(fadeTimer);
          fadeTimer = null;
        }
        fadeSlider();
      });

      window.addEventListener('resize', function () {
        if (fadeTimer) {
          clearTimeout(fadeTimer);
          fadeTimer = null;
        }
        fadeSlider();
      });
    }

    /* ═══ MOBILE MENU ═══ */
    var mobileMenu = document.getElementById('v3-mobile-menu-{{ section.id }}');
    var mobilePanel = mobileMenu
      ? mobileMenu.querySelector('.v3-mobile-menu__panel')
      : null;
    var hamburger = nav.querySelector('[data-nav-hamburger]');
    var mobileCloseTimer = null;
    var mobileL1View = mobileMenu
      ? mobileMenu.querySelector('[data-mobile-menu-l1-view]')
      : null;
    var activeMobileL2 = null;
    var activeMobileTrigger = null;
    var mobileDrillTimeline = null;
    var mobileNavigating = false;
    var mobileDrilling = false;

    /* ── GSAP duration (0 for reduced-motion users) ── */
    var motionDur = reducedMotion ? 0 : 0.2;
    var motionDurFast = reducedMotion ? 0 : 0.15;

    /* ═══ SEARCH DRAWER — SM–XL ═══ */
    if (searchDrawer && searchTrigger) {
      var searchInput = searchDrawer.querySelector('[data-search-input]');
      var searchInputField = searchDrawer.querySelector(
        '[data-search-input-field]'
      );
      var searchForm = searchDrawer.querySelector('[data-search-form]');
      var searchClear = searchDrawer.querySelector('[data-search-clear]');
      var searchBack = searchDrawer.querySelector('[data-search-back]');
      var searchClose = searchDrawer.querySelector('[data-search-close]');
      var searchStickyClose = searchDrawer.querySelector(
        '[data-search-sticky-close]'
      );
      var searchOverlay = searchDrawer.querySelector('[data-search-overlay]');
      var searchStates = searchDrawer.querySelector('[data-search-states]');
      var searchPredictive = searchDrawer.querySelector(
        '[data-search-predictive-results]'
      );
      var searchQueryLabel = searchDrawer.querySelector('[data-search-query]');
      var searchInfiniteProducts = searchDrawer.hasAttribute(
        'data-search-infinite-products'
      );
      var searchViewAll = searchDrawer.querySelector('[data-search-view-all]');
      var searchFooterHint = searchDrawer.querySelector(
        '[data-search-footer-hint]'
      );
      var searchFooter = searchDrawer.querySelector('[data-search-footer]');
      var searchFooterInner = searchFooter
        ? searchFooter.querySelector('.v3-search__footer-inner')
        : null;
      var searchAnnounce = searchDrawer.querySelector('[data-search-announce]');
      var searchScroll = searchDrawer.querySelector('[data-search-scroll]');
      var searchRecentSection = searchDrawer.querySelector(
        '[data-search-recent-section]'
      );
      var searchRecentList = searchDrawer.querySelector(
        '[data-search-recent-list]'
      );
      var searchRecentClear = searchDrawer.querySelector(
        '[data-search-recent-clear]'
      );
      var searchPanel = searchDrawer.querySelector('.v3-search__drawer');
