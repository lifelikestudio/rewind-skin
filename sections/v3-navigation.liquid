          <path d="M169.477 13.789V0.528646H171.147V13.789H169.477Z" fill="currentColor"/>
          <path d="M191.565 0.528646H193.235V13.789H191.565L177.828 2.53619V13.8419H176.158V0.528646H177.828L191.511 11.7815V0.528646H191.565Z" fill="currentColor"/>
        </svg>
      {%- endif -%}
    </a>

    {%- comment -%} Triggers {%- endcomment -%}
    <div class='xxs:gap-[8px] xs:gap-[10px] flex items-center justify-end gap-[6px]'>
      {%- if section.settings.show_search -%}
        <button
          type='button'
          class='text-ink flex h-[44px] w-[32px] items-center justify-center transition-colors duration-150 ease-out'
          aria-label='Search'
          aria-expanded='false'
          data-nav-search-mobile
        >
          {%- render 'v3-icon-search',
            size: 26,
            frame_size: 26,
            class: 'w-[24px] xxs:w-[25px] xs:w-[26px] h-[24px] xxs:h-[25px] xs:h-[26px]'
          -%}
        </button>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <button
          type='button'
          class='text-ink flex h-[44px] w-[32px] items-center justify-center transition-colors duration-150 ease-out'
          aria-label='Cart{% if cart_count > 0 %}, {{ cart_count }} {{ cart_count | pluralize: 'item', 'items' }}{% endif %}'
          aria-expanded='false'
          id='v3-cart-mobile'
          data-nav-cart-mobile
        >
          <span class='relative'>
            {%- render 'v3-icon-cart',
              size: 26,
              frame_size: 26,
              class: 'w-[24px] xxs:w-[25px] xs:w-[26px] h-[24px] xxs:h-[25px] xs:h-[26px]'
            -%}
            {%- if cart_count > 0 -%}
              <span
                class='
                  v3-nav__cart-badge
                  bg-ink text-bg rounded-pill
                  text-nav-badge ring-bg
                  absolute flex h-[18px]
                  w-[26px] items-center
                  justify-center text-center
                  font-medium tracking-tight ring-2
                '
                aria-hidden='true'
              >
                {{- cart_count_badge -}}
              </span>
            {%- endif -%}
          </span>
        </button>
      {%- endif -%}

      {%- comment -%} Hamburger pill (MobileMenuBtn) {%- endcomment -%}
      <button
        type='button'
        class='v3-nav__hamburger xs:px-[16px] bg-rest rounded-pill flex h-[32px] items-center justify-center px-[15px] transition-colors duration-150 ease-out'
        aria-label='Open menu'
        aria-expanded='false'
        data-nav-hamburger
      >
        {%- comment -%}
          Single SVG so both bars share one paint/AA pass. Two separate
          1.2px spans land on different subpixel Y offsets under flex
          centering and render at visibly different weights.
        {%- endcomment -%}
        <span
          class='flex items-center justify-center py-[2px]'
          aria-hidden='true'
        >
          <svg
            class='text-ink block'
            width='20'
            height='7.4'
            viewBox='0 0 20 7.4'
            fill='none'
            xmlns='http://www.w3.org/2000/svg'
            focusable='false'
          >
            <rect width='20' height='1.2' rx='0.6' fill='currentColor'/>
            <rect y='6.2' width='20' height='1.2' rx='0.6' fill='currentColor'/>
          </svg>
        </span>
      </button>
    </div>
  </div>
</nav>

{%- render 'v3-submenu-drawer',
  logo: section.settings.logo,
  shop_label: section.settings.shop_label,
  studio_label: section.settings.studio_label,
  section_id: section.id
-%}

{%- render 'v3-mobile-menu',
  logo: section.settings.logo,
  shop_label: section.settings.shop_label,
  studio_label: section.settings.studio_label,
  section_id: section.id
-%}

<style>
  .v3-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    font-family:
      'Scto Grotesk A',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      Oxygen-Sans,
      Ubuntu,
      Cantarell,
      'Helvetica Neue',
      sans-serif;
    font-weight: 400;
