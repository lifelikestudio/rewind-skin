          <path d="M68.6328 13.789V0.528646H70.3028V13.789H68.6328Z" fill="currentColor"/>
          <path d="M90.6626 0.528646H92.3327V13.789H90.6626L76.9793 2.53619V13.8419H75.3092V0.528646H76.9793L90.6626 11.7815V0.528646Z" fill="currentColor"/>
