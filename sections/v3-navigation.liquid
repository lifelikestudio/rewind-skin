          <path d="M169.477 13.789V0.528646H171.147V13.789H169.477Z" fill="currentColor"/>
          <path d="M191.565 0.528646H193.235V13.789H191.565L177.828 2.53619V13.8419H176.158V0.528646H177.828L191.511 11.7815V0.528646H191.565Z" fill="currentColor"/>
        </svg>
      {%- endif -%}
    </a>

    {%- comment -%} Triggers {%- endcomment -%}
    <div class='xxs:gap-[8px] xs:gap-[10px] flex items-center justify-end gap-[6px]'>
      {%- if section.settings.show_search -%}
        <button
          type='button'
          class='text-ink flex h-[44px] w-[32px] items-center justify-center transition-colors duration-150 ease-out'
          aria-label='Search'
          data-nav-search-mobile
        >
          {%- render 'v3-icon-search',
            size: 26,
            frame_size: 26,
            class: 'w-[24px] xxs:w-[25px] xs:w-[26px] h-[24px] xxs:h-[25px] xs:h-[26px]'
          -%}
        </button>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <a
          href='{{ routes.cart_url }}'
          class='text-ink relative flex h-[44px] w-[32px] items-center justify-center transition-colors duration-150 ease-out'
          aria-label='{{ 'templates.cart.cart' | t }}{% if cart_count > 0 %}, {{ cart_count }} {{ 'templates.cart.item_count' | t }}{% endif %}'
          id='v3-cart-mobile'
        >
          {%- render 'v3-icon-cart',
            size: 26,
            frame_size: 26,
            class: 'w-[24px] xxs:w-[25px] xs:w-[26px] h-[24px] xxs:h-[25px] xs:h-[26px]'
          -%}
          {%- if cart_count > 0 -%}
            <span
              class='
                bg-ink text-bg rounded-pill
                border-bg text-nav-badge absolute
                -top-[4px] left-[56%] flex
                h-[18px] min-w-[18px]
                items-center justify-center border-2
                px-[4px] font-medium tracking-tight
              '
              aria-hidden='true'
            >
              {{- cart_count_display -}}
            </span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- comment -%} Hamburger pill (MobileMenuBtn) {%- endcomment -%}
      <button
        type='button'
        class='v3-nav__hamburger xs:px-[16px] xs:ml-[3px] xxs:ml-[3.5px] bg-rest rounded-pill flex h-[32px] items-center justify-center px-[15px] ml-[4px] transition-colors duration-150 ease-out'
        aria-label='Open menu'
        aria-expanded='false'
        data-nav-hamburger
      >
        <span class='flex flex-col items-center justify-center gap-[5px] py-[2px]'>
          <span class='bg-ink rounded-pill block h-[1.2px] w-[20px]'></span>
          <span class='bg-ink rounded-pill block h-[1.2px] w-[20px]'></span>
        </span>
      </button>
    </div>
  </div>
</nav>

<style>
  .v3-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    font-family:
      'Scto Grotesk A',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      Oxygen-Sans,
      Ubuntu,
      Cantarell,
      'Helvetica Neue',
      sans-serif;
    font-weight: 400;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .v3-nav button,
  .v3-nav a,
  .v3-nav input {
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  /* Desktop: optical padding offset (right container padding is smaller,
     rightmost link's internal padding makes text edge align with left) */
  .v3-nav > div:first-child {
    --v3-nav-pr-offset: 0px;
    padding-right: 6px;
  }
  @media (min-width: 768px) {
    .v3-nav > div:first-child {
      padding-right: 6px;
    }
  }
  @media (min-width: 1024px) {
    .v3-nav > div:first-child {
      padding-right: 10px;
    }
  }
  @media (min-width: 1280px) {
    .v3-nav > div:first-child {
      padding-right: 10px;
    }
  }
  @media (min-width: 1440px) {
    .v3-nav > div:first-child {
      padding-right: 18px;
    }
  }
  @media (min-width: 1920px) {
    .v3-nav > div:first-child {
      padding-right: 26px;
    }
  }

  /* ═══ PRESSED STATES (all input types) ═══ */

  .v3-nav__switch-btn:active {
    background-color: var(--color-bg);
  }
  .v3-nav__search-pill:active {
    background-color: var(--color-pressed);
  }
  .v3-nav__search-pill:active > span:last-child {
    background-color: var(--color-rest);
  }
  .v3-nav__naked-btn:active {
    background-color: var(--color-pressed);
  }

  /* ═══ HOVER STATES (pointer devices only) ═══ */

  @media (hover: hover) {
    .v3-nav__slider {
      will-change: left, width, opacity;
    }

    .v3-nav__switch-btn {
      transition:
        color 150ms ease-out 200ms,
        background-color 150ms ease-out;
    }

    .v3-nav__search-pill:hover {
      background-color: var(--color-hover);
    }
    .v3-nav__search-pill:hover > span:last-child {
      background-color: var(--color-rest);
    }

    .v3-nav__naked-btn:hover {
      background-color: var(--color-rest);
    }

    /* Demote siblings — supporting group */
    .group\/supporting:has(.v3-nav__naked-btn:hover) .v3-nav__naked-btn {
      color: var(--color-muted);
      transition: color 150ms ease-out;
    }
    .group\/supporting:has(.v3-nav__naked-btn:hover) .v3-nav__naked-btn:hover {
      color: var(--color-ink);
    }

    /* Demote siblings — priority group */
    .group\/priority:has(.v3-nav__switch-btn:hover, .v3-nav__search-pill:hover)
      .v3-nav__switch-btn,
    .group\/priority:has(.v3-nav__switch-btn:hover, .v3-nav__search-pill:hover)
      .v3-nav__search-pill
      span:first-child {
      color: var(--color-muted);
      transition: color 150ms ease-out;
    }
    .group\/priority:has(.v3-nav__switch-btn:hover, .v3-nav__search-pill:hover)
      .v3-nav__switch-btn:hover,
    .group\/priority:has(.v3-nav__switch-btn:hover, .v3-nav__search-pill:hover)
      .v3-nav__search-pill:hover
      span:first-child {
      color: var(--color-ink);
    }
  }

  /* ═══ MOBILE: hamburger pressed ═══ */
  .v3-nav__hamburger:active {
    background-color: var(--color-pressed);
  }

  /* ═══ VISITED LINKS ═══ */
  .v3-nav a,
  .v3-nav a:visited {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* ═══ FOCUS VISIBLE ═══ */
  .v3-nav button:focus-visible,
  .v3-nav a:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
    border-radius: 9999px;
  }

  /* ═══ REDUCED MOTION ═══ */
  @media (prefers-reduced-motion: reduce) {
    .v3-nav,
    .v3-nav * {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  (function () {
    const nav = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!nav) return;

    /* Shop/Studio — fire context event for submenu system (built later) */
    var toggleBtns = nav.querySelectorAll('[data-nav-toggle]');
    toggleBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var context = btn.getAttribute('data-nav-toggle');
        nav.setAttribute('data-nav-context', context);
        document.dispatchEvent(
          new CustomEvent('nav:context-change', {
            detail: { context: context },
          })
        );
      });
    });

    /* Shop/Studio hover slider (pointer devices only) */
    var hasHover = window.matchMedia('(hover: hover)').matches;
    var reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    var pathsGroup = nav.querySelector('[data-nav-paths]');
    var slider = pathsGroup
      ? pathsGroup.querySelector('.v3-nav__slider')
      : null;

    if (hasHover && slider && toggleBtns.length) {
      var sliderActive = false;
      var fadeTimer = null;

      function positionSlider(btn, animate) {
        slider.style.transition = reducedMotion
          ? 'none'
          : animate
            ? 'left 200ms ease-out, width 200ms ease-out, opacity 150ms ease-out'
            : 'opacity 150ms ease-out';
        slider.style.width = btn.offsetWidth + 'px';
        slider.style.left = btn.offsetLeft + 'px';
        slider.style.opacity = '1';
      }

      function fadeSlider() {
        slider.style.transition = reducedMotion
          ? 'none'
          : 'opacity 150ms ease-out';
        slider.style.opacity = '0';
        sliderActive = false;
      }

      toggleBtns.forEach(function (btn) {
        btn.addEventListener('mouseenter', function () {
          if (fadeTimer) {
            clearTimeout(fadeTimer);
            fadeTimer = null;
          }
          positionSlider(btn, sliderActive);
          sliderActive = true;
        });

        btn.addEventListener('mouseleave', function (e) {
          if (
            e.relatedTarget &&
            e.relatedTarget.closest &&
            e.relatedTarget.closest('[data-nav-toggle]')
          )
            return;
          fadeTimer = setTimeout(fadeSlider, 200);
        });
      });

      pathsGroup.addEventListener('mouseleave', function () {
        if (fadeTimer) {
          clearTimeout(fadeTimer);
          fadeTimer = null;
        }
        fadeSlider();
      });
    }

    /* Hamburger */
    const hamburger = nav.querySelector('[data-nav-hamburger]');
    if (hamburger) {
      hamburger.addEventListener('click', function () {
        const expanded = hamburger.getAttribute('aria-expanded') === 'true';
        hamburger.setAttribute('aria-expanded', String(!expanded));
        document.dispatchEvent(
          new CustomEvent('nav:menu-toggle', {
            detail: { open: !expanded },
          })
        );
      });
    }
  })();
</script>

