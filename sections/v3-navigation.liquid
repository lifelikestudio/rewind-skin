      /* Give newly visible transfer layers a painted starting state before
         GSAP advances them. This prevents the first hand-off from snapping
         while the browser creates the backdrop-filter compositor layer. */
      function playSearchTransferAfterPaint(timeline) {
        if (!timeline) return;

        var completed = false;
        var fallbackTimer = window.setTimeout(play, 100);

        function play() {
          if (completed) return;
          completed = true;
          window.clearTimeout(fallbackTimer);
          if (searchTransferTimeline === timeline) timeline.play(0);
        }

        if (document.hidden) {
          play();
          return;
        }

        window.requestAnimationFrame(function () {
          if (document.hidden) {
            play();
            return;
          }
          window.requestAnimationFrame(play);
        });
      }

      function shareMobileMenuLogoWithSearch() {
        if (
          mobileMenuLogoIsShared ||
          !mobileMenuLogo ||
          !searchLogo ||
          !searchLogo.parentNode
        ) {
          return;
        }
        searchLogo.style.display = 'none';
        searchLogo.parentNode.insertBefore(mobileMenuLogo, searchLogo);
        gsap.set(mobileMenuLogo, { opacity: 1 });
        mobileMenuLogoIsShared = true;
      }

      function restoreMobileMenuLogo() {
        if (!mobileMenuLogoIsShared || !mobileMenuLogoParent) return;
        mobileMenuLogoParent.insertBefore(
          mobileMenuLogo,
          mobileMenuLogoNextSibling
        );
        if (searchLogo) searchLogo.style.display = '';
        gsap.set(mobileMenuLogo, { clearProps: 'opacity' });
        mobileMenuLogoIsShared = false;
      }

      function prepareMobileBackdropTransfer(panelRect, panelStyles) {
        clearMobileBackdropTransfer();

        var backdrop = document.querySelector('[data-v3-modal-backdrop]');
        if (!backdrop) return null;

        var backdropStyles = window.getComputedStyle(backdrop);
        var viewportWidth = document.documentElement.clientWidth;
        var viewportHeight = window.innerHeight;
        var clip = [
          Math.max(0, panelRect.top),
          Math.max(0, viewportWidth - panelRect.right),
          Math.max(0, viewportHeight - panelRect.bottom),
          Math.max(0, panelRect.left),
        ];

        mobileTransferBackdrop = backdrop;
        gsap.set(backdrop, {
          clipPath:
            'inset(' +
            clip.join('px ') +
            'px round ' +
            panelStyles.borderRadius +
            ')',
          backgroundColor: panelStyles.backgroundColor,
          backdropFilter: panelStyles.backdropFilter,
          webkitBackdropFilter: panelStyles.webkitBackdropFilter,
          opacity: 0,
          transition: 'none',
          willChange: 'clip-path, background-color, backdrop-filter',
        });

        return {
          backgroundColor: backdropStyles.backgroundColor,
          backdropFilter: backdropStyles.backdropFilter,
          webkitBackdropFilter: backdropStyles.webkitBackdropFilter,
        };
      }

      function clearMobileBackdropTransfer(deferClear) {
        restoreMobileMenuLogo();
        if (!mobileTransferBackdrop) return;

        var backdrop = mobileTransferBackdrop;
        mobileTransferBackdrop = null;
        gsap.killTweensOf(backdrop);

        function clearBackdropStyles() {
          if (mobileTransferBackdrop) return;
          gsap.set(backdrop, {
            clearProps:
              'opacity,clipPath,backgroundColor,backdropFilter,webkitBackdropFilter,transition,willChange',
          });
        }

        if (deferClear) {
          window.requestAnimationFrame(clearBackdropStyles);
        } else {
          clearBackdropStyles();
        }
      }

      function getSearchRevealParts() {
        var supporting = [];
        var products = Array.from(
          searchDrawer.querySelectorAll(
            '[data-search-fallback] .v3-search__product-card'
          )
        );
        var fallbackSections = searchDrawer.querySelectorAll(
          '[data-search-fallback] > .v3-search__subgroup'
        );

        if (searchRecentSection && !searchRecentSection.hidden) {
          supporting.push(searchRecentSection);
        }

        fallbackSections.forEach(function (section) {
          if (section.querySelector('.v3-search__product-card')) {
            var heading = section.querySelector('.v3-search__subgroup-title');
            if (heading) supporting.push(heading);
          } else {
            supporting.push(section);
          }
        });

        var field = searchForm ? [searchForm] : [];
        return {
          field: field,
          supporting: supporting,
          products: products,
          all: field.concat(supporting, products),
        };
      }

      function clearSearchRevealStyles() {
        var parts = getSearchRevealParts();
        gsap.killTweensOf(parts.all);
        gsap.set(parts.all, { clearProps: 'opacity' });
        if (searchBody) gsap.set(searchBody, { clearProps: 'opacity' });
        searchDrawer.removeAttribute('data-search-reveal');
      }

      function stopSearchReveal() {
        if (searchRevealTimeline) {
          searchRevealTimeline.kill();
          searchRevealTimeline = null;
        }
        clearSearchRevealStyles();
      }

      function addSearchReveal(timeline, fieldStart) {
        var parts = getSearchRevealParts();
        var revealDuration = reducedMotion ? 0 : 0.25;
        var supportingStart = fieldStart + (reducedMotion ? 0 : 0.07);
        var productStagger = reducedMotion ? 0 : 0.03;

        searchDrawer.setAttribute('data-search-reveal', '');
        if (searchBody) gsap.set(searchBody, { opacity: 1 });
        gsap.set(parts.all, { opacity: 0 });

        timeline.addLabel('search-field-reveal', fieldStart);
        timeline.addLabel('search-supporting-reveal', supportingStart);

        if (parts.field.length) {
          timeline.to(
            parts.field,
            { opacity: 1, duration: revealDuration, ease: 'power1.out' },
            'search-field-reveal'
          );
        }
        if (parts.supporting.length) {
          timeline.to(
            parts.supporting,
            { opacity: 1, duration: revealDuration, ease: 'power1.out' },
            'search-supporting-reveal'
          );
        }
        if (parts.products.length) {
          timeline.to(
            parts.products,
            {
              opacity: 1,
              duration: revealDuration,
              ease: 'power1.out',
              stagger: productStagger,
            },
            'search-supporting-reveal'
          );
        }
      }

      function playSearchReveal(fieldStart) {
        stopSearchReveal();
        searchRevealTimeline = gsap.timeline({
          onComplete: function () {
            clearSearchRevealStyles();
            searchRevealTimeline = null;
          },
        });
        addSearchReveal(searchRevealTimeline, fieldStart);
      }

      function setSearchView(view, immediate, onViewChange) {
        function applyView() {
          searchDrawer.setAttribute('data-search-view', view);
          if (onViewChange) onViewChange();
        }

        if (!searchStates) {
          applyView();
          return;
        }

        gsap.killTweensOf(searchStates);
        if (immediate || reducedMotion) {
          applyView();
          gsap.set(searchStates, { clearProps: 'opacity' });
          return;
        }

        gsap.to(searchStates, {
          opacity: 0,
          duration: motionDurFast,
          ease: 'power1.out',
          onComplete: function () {
            applyView();
            gsap.to(searchStates, {
              opacity: 1,
              duration: motionDur,
              ease: 'power1.out',
              onComplete: function () {
                gsap.set(searchStates, { clearProps: 'opacity' });
              },
            });
          },
        });
      }

      function revealSearchFooter() {
        if (!searchFooter) return;
        var footerLayers = [searchFooterInner].filter(Boolean);
        gsap.killTweensOf(footerLayers);
        if (reducedMotion) {
          gsap.set(footerLayers, { clearProps: 'opacity,transform' });
          return;
        }

        var footerTimeline = gsap.timeline({
          delay: motionDurFast / 2,
          onComplete: function () {
            gsap.set(footerLayers, { clearProps: 'opacity,transform' });
          },
        });
        if (searchFooterInner) {
          footerTimeline.fromTo(
            searchFooterInner,
            { opacity: 0, y: 4 },
            {
              opacity: 1,
              y: 0,
              duration: motionDur,
              ease: 'power1.out',
            },
            motionDurFast / 2
          );
        }
      }

      function updateSearchQueryState() {
        var query = searchInput ? searchInput.value.trim() : '';
        if (query) {
          searchDrawer.setAttribute('data-search-has-query', '');
        } else {
          searchDrawer.removeAttribute('data-search-has-query');
        }
        return query;
      }

      function normalizeSearchText(value) {
        return String(value || '')
          .normalize('NFKD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/&/g, ' and ')
          .replace(/['’]/g, '')
          .replace(/[^\p{L}\p{N}]+/gu, ' ')
          .trim()
          .replace(/\s+/g, ' ')
          .toLocaleLowerCase();
      }

      var recentSearchStorageKey = 'rewind:v3:recent-searches';

      function readRecentSearches() {
        try {
          var stored = JSON.parse(
            window.localStorage.getItem(recentSearchStorageKey) || '[]'
          );
          if (!Array.isArray(stored)) return [];
          var recent = stored
            .filter(function (item) {
              return (
                item &&
                typeof item.key === 'string' &&
                typeof item.label === 'string'
              );
            })
            .slice(0, 3);
          if (stored.length !== recent.length) {
            try {
              window.localStorage.setItem(
                recentSearchStorageKey,
                JSON.stringify(recent)
              );
            } catch (_) {
              return recent;
            }
          }
          return recent;
        } catch (_) {
          return [];
        }
      }

      function renderRecentSearches() {
        if (!searchRecentSection || !searchRecentList) return;
        var recent = readRecentSearches().slice(0, 3);
        searchRecentList.innerHTML = '';
        recent.forEach(function (item) {
          var button = document.createElement('button');
          var text = document.createElement('span');
          button.type = 'button';
          button.className = 'v3-search__suggestion';
          button.setAttribute('data-search-suggestion', '');
          button.setAttribute('data-search-suggestion-value', item.label);
          text.className = 'v3-search__suggestion-text text-search-suggestion';
          text.textContent = item.label;
          button.appendChild(text);
          searchRecentList.appendChild(button);
        });
        searchRecentSection.hidden = recent.length === 0;
      }

      function recordRecentSearch(value) {
        var label = String(value || '')
          .trim()
          .replace(/\s+/g, ' ');
        var key = normalizeSearchText(label);
        if (!key) return;
        var recent = readRecentSearches().filter(function (item) {
          return item.key !== key;
        });
        recent.unshift({ key: key, label: label });
        try {
          window.localStorage.setItem(
            recentSearchStorageKey,
            JSON.stringify(recent.slice(0, 3))
          );
        } catch (_) {
          return;
        }
        renderRecentSearches();
      }

      function recordCompletedSearch() {
        var query = searchInput ? searchInput.value : '';
        if (searchCompletedRequestId !== searchRequestSequence) return;
        if (!searchCompletedHasResults) return;
        if (
          normalizeSearchText(query) !==
          normalizeSearchText(searchCompletedQuery)
        )
          return;
        recordRecentSearch(query);
      }

      function stopSearchLoading() {
        if (searchLoadingTimer) {
          clearTimeout(searchLoadingTimer);
          searchLoadingTimer = null;
        }
        searchDrawer.removeAttribute('data-search-loading');
      }

      function beginSearchLoading(requestId) {
        stopSearchLoading();
        if (searchStates) searchStates.setAttribute('aria-busy', 'true');
        searchLoadingTimer = setTimeout(function () {
          searchLoadingTimer = null;
          if (requestId !== searchRequestSequence) return;
