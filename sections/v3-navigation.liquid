        var closing = activeMobileL2;
        var levels = mobileMenu.querySelector('.v3-mobile-menu__levels');

        mobileDrillTimeline = gsap.timeline();
        mobileDrillTimeline
          .to(closing, { opacity: 0, duration: motionDur, ease: 'power1.out' })
          .call(function () {
            closing.classList.remove('is-active');
            gsap.set(closing, { clearProps: 'opacity' });
            activeMobileL2 = null;
            mobileL1View.classList.remove('is-hidden');
            gsap.set(mobileL1View, { opacity: 0 });
            if (levels) levels.scrollTop = 0;
