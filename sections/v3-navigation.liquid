        : null;
      var mobileMenuLogoNextSibling = mobileMenuLogo
        ? mobileMenuLogo.nextSibling
        : null;
      var mobileMenuLogoIsShared = false;
      var searchTransferElements = [
        drawer,
        submenuLogo,
        submenuActions,
        submenuToggleGroup,
        submenuClose,
        submenuNav,
        mobilePanel,
        mobileMenuHeading,
        mobileMenuLogo,
        mobileMenuClose,
        mobileMenuToggleWrap,
        mobileMenuNav,
        mobileMenuUtility,
        searchPanel,
        searchLogo,
        searchClose,
        searchBody,
