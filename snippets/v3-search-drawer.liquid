{% comment %}
  V3 Search Drawer — desktop SM–XL.

  Parameters:
    logo                — image object from parent navigation section
    section_id          — parent section id
    popular_terms       — comma-separated fallback search terms
    popular_collection  — collection used for fallback product cards
{% endcomment %}

{%- liquid
  assign search_terms = popular_terms | split: ','
  assign fallback_products = popular_collection.products
  assign featured_product_limit = 4
  assign featured_product_count = 0
  assign featured_product_handles = '|'
  assign featured_product_vendors = '|'
  assign featured_product_categories = '|'
  assign non_category_tags = '|bestseller|subscribe|'

  # Select diverse bestsellers in three passes: unique vendor and category,
  # unique vendor, then any remaining eligible product.
  for selection_pass in (1..3)
    if featured_product_count >= featured_product_limit
      break
    endif

    for product in fallback_products
      if featured_product_count >= featured_product_limit
        break
      endif

      unless product.available
        continue
      endunless

      if product.featured_image == blank
        continue
      endif

      assign product_handle_key = product.handle | prepend: '|' | append: '|'
      if featured_product_handles contains product_handle_key
        continue
      endif

      assign product_vendor_handle = product.vendor | handleize
      assign product_vendor_key = product_vendor_handle | prepend: '|' | append: '|'
      if selection_pass < 3
        if product.vendor == blank
          continue
        endif
        if featured_product_vendors contains product_vendor_key
          continue
        endif
      endif

      assign product_category_keys = blank
      assign product_category_is_used = false
      if selection_pass == 1
        for tag in product.tags
          assign tag_key = tag | handleize | prepend: '|' | append: '|'
          unless non_category_tags contains tag_key
            assign product_category_keys = product_category_keys | append: tag_key
            if featured_product_categories contains tag_key
              assign product_category_is_used = true
            endif
          endunless
        endfor

        if product_category_keys == blank or product_category_is_used
          continue
        endif
      endif

      assign featured_product_handles = featured_product_handles | append: product.handle | append: '|'
      assign featured_product_count = featured_product_count | plus: 1

      unless featured_product_vendors contains product_vendor_key
        assign featured_product_vendors = featured_product_vendors | append: product_vendor_handle | append: '|'
      endunless

      if product_category_keys != blank
        assign featured_product_categories = featured_product_categories | append: product_category_keys
      endif
    endfor
  endfor

  assign featured_product_handles = featured_product_handles | split: '|'
-%}

<aside
  id='v3-search-drawer-{{ section_id }}'
  class='v3-search'
  data-search-drawer
  data-search-state='closed'
  data-search-view='initial'
  data-predictive-url='{{ routes.predictive_search_url }}'
  aria-hidden='true'
  aria-label='Search'
>
  <div class='v3-search__overlay' data-search-overlay aria-hidden='true'></div>

  <div
    class='v3-search__drawer'
    role='dialog'
    aria-modal='true'
    aria-label='Search rewindskinco.com'
  >
    <div class='v3-search__scroll' data-search-scroll>
      <header class='v3-search__header'>
        <a
          href='{{ routes.root_url }}'
          class='v3-search__logo'
          aria-label='{{ shop.name }}'
        >
          {%- render 'v3-logotype',
            logo: logo,
            class: 'v3-search__logo-image'
          -%}
        </a>

        <button
          type='button'
          class='v3-search__close'
          data-search-close
          aria-label='Close search'
        >
          <span class='v3-search__close-circle'>
            {%- render 'v3-icon-close',
              class: 'v3-search__close-icon text-ink'
            -%}
          </span>
        </button>
      </header>

      <div class='v3-search__body'>
        <form
          action='{{ routes.search_url }}'
          method='get'
          role='search'
          class='v3-search__form'
          data-search-form
        >
          <label
            class='sr-only'
            for='v3-search-input-{{ section_id }}'
          >
            Search products and treatments
          </label>
          <div class='v3-search__input-ring'>
            <div class='v3-search__input-field' data-search-input-field>
              <span class='v3-search__input-leading'>
                <span class='v3-search__input-icon'>
                  {%- render 'v3-icon-search',
                    size: 12,
                    class: 'h-12 w-12 text-muted'
                  -%}
                </span>
                <button
                  type='button'
                  class='v3-search__input-back'
                  data-search-back
                  aria-label='Back to menu'
                  hidden
                >
                  {%- render 'v3-icon-arrow-left', class: 'text-muted' -%}
                </button>
              </span>
              <input
                id='v3-search-input-{{ section_id }}'
                class='v3-search__input text-search-input'
                type='search'
                name='q'
                value=''
                placeholder='Search products and treatments...'
                autocomplete='off'
                autocorrect='off'
                autocapitalize='off'
                spellcheck='false'
                enterkeyhint='search'
                aria-controls='v3-search-results-{{ section_id }}'
                data-search-input
              >
              <div class='v3-search__input-actions'>
                <button
                  type='button'
                  class='v3-search__input-clear'
                  data-search-clear
                  aria-label='Clear search'
                >
                  <span data-search-clear-active aria-hidden='true'>
                    <span class='v3-search__input-clear-text text-search-small'>
                      Clear
                    </span>
                  </span>
                </button>
                <button
                  type='button'
                  class='v3-search__input-close'
                  data-search-sticky-close
                  aria-label='Close search'
                >
                  {%- render 'v3-icon-close', size: 8, class: 'text-muted' -%}
                </button>
              </div>
            </div>
          </div>
        </form>

        <div class='v3-search__content'>
          <div
            id='v3-search-results-{{ section_id }}'
            class='v3-search__states'
            aria-busy='false'
            data-search-states
          >
            <div class='v3-search__callout' data-search-callout>
              <p class='text-search-callout-title'>
                We couldn't find anything related to “<span
                  data-search-query
                ></span
                >”.
              </p>
              <p class='text-search-callout-body'>
                Try a different word, phrase, or start with one of our
                favourites below.
              </p>
            </div>

            <section
              class='v3-search__subgroup v3-search__recent'
              data-search-recent-section
              hidden
            >
              <div class='v3-search__subgroup-heading'>
                <h2 class='v3-search__subgroup-title text-search-caption'>
                  Recent searches
                </h2>
                <button
                  type='button'
                  class='v3-search__recent-clear text-search-recent-clear'
                  data-search-recent-clear
                >
                  Clear recent
                </button>
              </div>
              <div
                class='v3-search__suggestion-list'
                data-search-recent-list
              ></div>
            </section>

            <div class='v3-search__fallback' data-search-fallback>
              {%- if popular_terms != blank -%}
                <section class='v3-search__subgroup'>
                  <h2 class='v3-search__subgroup-title text-search-caption'>
                    Popular with clients
                  </h2>
                  <div class='v3-search__suggestion-list'>
                    {%- for term in search_terms limit: 5 -%}
                      {%- assign clean_term = term | strip -%}
                      {%- if clean_term != blank -%}
                        {%- assign lowercase_term = clean_term | downcase -%}
                        <button
                          type='button'
                          class='v3-search__suggestion'
                          data-search-suggestion
                          data-search-suggestion-value='{{ lowercase_term | escape }}'
                        >
                          <span class='v3-search__suggestion-text text-search-suggestion'>
                            {{- lowercase_term | escape -}}
                          </span>
                        </button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </section>
              {%- endif -%}

              {%- if featured_product_count > 0 -%}
                <section class='v3-search__subgroup'>
                  <h2 class='v3-search__subgroup-title text-search-caption'>
                    Featured bestsellers
                  </h2>
                  <div class='v3-search__product-list'>
                    {%- for featured_product_handle in featured_product_handles -%}
                      {%- if featured_product_handle == blank -%}
                        {%- continue -%}
                      {%- endif -%}
                      {%- for product in fallback_products -%}
                        {%- if product.handle == featured_product_handle -%}
                          {%- render 'v3-search-product-card',
                            product: product
                          -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endfor -%}
                  </div>
                </section>
              {%- endif -%}
            </div>

            <div
              class='v3-search__predictive'
              data-search-predictive-results
            ></div>

            <section
              class='v3-search__loading'
              data-search-loading-first
              aria-hidden='true'
            >
              <h2 class='v3-search__subgroup-title text-search-caption'>
                Finding your matches
              </h2>
              <div class='v3-search__product-list'>
                {%- for index in (1..3) -%}
                  <div class='v3-search__product-card v3-search__product-silhouette'>
                    <span class='v3-search__product-image'></span>
                    <div class='v3-search__product-data'>
                      <div class='v3-search__product-meta'>
                        <span class='v3-search__silhouette-line text-search-product-meta'></span>
                        <span
                          class='v3-search__silhouette-line v3-search__silhouette-line--title text-search-product-meta'
                        ></span>
                        <div class='v3-search__product-price'>
                          <span
                            class='v3-search__silhouette-line v3-search__silhouette-line--price text-search-product-price'
                          ></span>
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>

    <footer class='v3-search__footer' data-search-footer>
      <div class='v3-search__footer-inner'>
        <a
          href='{{ routes.search_url }}'
          class='v3-search__view-all'
          data-search-view-all
        >
          <span class='v3-search__view-all-text text-search-view-all'>
            View all
          </span>
        </a>
        <span
          class='v3-search__footer-hint text-search-footer-hint'
          data-search-footer-hint
          >or press enter</span
        >
      </div>
    </footer>

    <span
      class='sr-only'
      aria-live='polite'
      aria-atomic='true'
      data-search-announce
    ></span>
  </div>
</aside>

<style>
  .v3-search {
    --search-inset: 7px;
    --search-radius: 19px;
    --search-max-h: none;
    --search-header-h: auto;
    --search-header-pl: 20px;
    --search-header-pr: 2px;
    --search-header-py: 14px;
    --search-close-touch: 44px;
    --search-close-size: 32px;
    --search-close-icon: 11px;
    --search-content-p: 20px;
    --search-content-gap: 48px;
    --search-subgroup-gap: 27px;
    --search-link-gap: 13px;
    --search-input-h: 38px;
    --search-input-close-icon: 8px;
    --search-suggestion-h: 32px;
    --search-suggestion-touch-h: 42px;
    --search-suggestion-row-gap: 0px;
    --search-footer-p: 20px;
    --search-footer-h: 82px;
    --search-footer-gap: 12px;
    --search-button-h: 42px;
    --search-callout-gap: 12px;
    position: fixed;
    inset: 0;
    z-index: 60;
    display: block;
    visibility: hidden;
    pointer-events: none;
    font-family: var(--font-family-base);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-base);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .v3-search[data-search-state='open'],
  .v3-search[data-search-state='closing'] {
    visibility: visible;
    pointer-events: auto;
  }

  .v3-search[data-search-state='closing'] {
    pointer-events: none;
  }

  @media (min-width: 375px) {
    .v3-search {
      --search-inset: 8px;
      --search-header-pl: 22px;
      --search-header-pr: 5px;
      --search-header-py: 18px;
      --search-close-size: 36px;
      --search-close-icon: 12px;
      --search-content-p: 22px;
      --search-content-gap: 52px;
      --search-subgroup-gap: 28px;
      --search-link-gap: 14px;
      --search-footer-p: 22px;
      --search-footer-h: 86px;
    }
  }

  @media (min-width: 428px) {
    .v3-search {
      --search-radius: 20px;
      --search-header-pl: 24px;
      --search-header-pr: 7px;
      --search-header-py: 21px;
      --search-close-size: 38px;
      --search-content-p: 24px;
      --search-content-gap: 56px;
      --search-subgroup-gap: 30px;
      --search-link-gap: 14.5px;
      --search-footer-p: 24px;
      --search-footer-h: 90px;
    }
  }

  @media (min-width: 768px) {
    .v3-search {
      --search-inset: 12px;
      --search-header-h: 86px;
      --search-header-pl: 24px;
      --search-header-pr: 10px;
      --search-header-py: 24px;
      --search-close-touch: 38px;
      --search-close-size: 38px;
      --search-close-icon: 12px;
    }
  }

  @media (min-width: 1280px) {
    .v3-search {
      --search-inset: 14px;
      --search-suggestion-touch-h: var(--search-suggestion-h);
      --search-suggestion-row-gap: 10px;
    }
  }

  @media (min-width: 1440px) {
    .v3-search {
      --search-inset: 16px;
      --search-radius: 24px;
      --search-header-h: 104px;
      --search-header-pl: 32px;
      --search-header-pr: 17px;
      --search-header-py: 32px;
      --search-close-touch: 40px;
      --search-close-size: 40px;
      --search-content-p: 32px;
      --search-content-gap: 64px;
      --search-footer-p: 32px;
      --search-input-h: 40px;
      --search-subgroup-gap: 32px;
      --search-link-gap: 16px;
      --search-footer-h: 108px;
      --search-footer-gap: 14px;
      --search-button-h: 44px;
      --search-callout-gap: 14px;
    }
  }

  @media (min-width: 1920px) {
    .v3-search {
      --search-input-close-icon: 10px;
      --search-suggestion-h: 34px;
    }
  }

  /* Match the submenu shell: fill landscape SM–LG viewports, then use the
     established 864px ceiling for portrait contexts and XL screens. */
  @media (min-width: 768px) and (orientation: portrait), (min-width: 1920px) {
    .v3-search {
      --search-max-h: 864px;
    }
  }

  .v3-search button,
  .v3-search a,
  .v3-search input {
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
  }

  .v3-search a,
  .v3-search a:visited {
    color: var(--color-ink);
    text-decoration: none;
  }

  .v3-search__overlay {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(251, 250, 249, 0.5);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    opacity: 0;
    transition: opacity 250ms ease-out;
  }

  .v3-search[data-search-state='open'] .v3-search__overlay {
    opacity: 1;
  }

  .v3-search[data-search-state='closing'] .v3-search__overlay {
    opacity: 0;
    transition-duration: 200ms;
  }

  .v3-search__drawer {
    position: absolute;
    top: var(--search-inset);
    left: var(--search-inset);
    display: flex;
    width: calc(100% - var(--search-inset) * 2);
    height: calc(100dvh - var(--search-inset) * 2);
    max-height: var(--search-max-h);
    isolation: isolate;
    flex-direction: column;
    overflow: clip;
    border-radius: var(--search-radius);
    background: var(--color-bg);
    color: var(--color-ink);
    opacity: 0;
    transition: opacity 250ms ease-out 80ms;
  }

  @media (min-width: 768px) {
    .v3-search__drawer {
      width: 456px;
    }
  }

  .v3-search[data-search-state='open'] .v3-search__drawer {
    opacity: 1;
  }

  .v3-search[data-search-state='closing'] .v3-search__drawer {
    opacity: 0;
    transition: opacity 180ms ease-out;
  }

  .v3-search__header {
    display: flex;
    height: var(--search-header-h);
    flex: none;
    align-items: center;
    justify-content: space-between;
    padding: var(--search-header-py) var(--search-header-pr)
      var(--search-header-py) var(--search-header-pl);
  }

  .v3-search__logo,
  .v3-search__close,
  .v3-search__body {
    opacity: 0;
  }

  .v3-search__logo {
    display: block;
    flex: none;
    transition: opacity 200ms ease-out;
  }

  .v3-search__logo-image {
    display: block;
    width: 193px;
    height: 14px;
  }

  @media (min-width: 375px) {
    .v3-search__logo-image {
      width: 207px;
      height: 15px;
    }
  }

  @media (min-width: 428px) {
    .v3-search__logo-image {
      width: 221px;
      height: 16px;
    }
  }

  @media (min-width: 768px) {
    .v3-search__logo-image {
      width: 220px;
      height: 16px;
    }
  }

  @media (min-width: 1440px) {
    .v3-search__logo-image {
      width: 248px;
      height: 18px;
    }
  }

  .v3-search__close {
    position: relative;
    z-index: 2;
    display: flex;
    width: var(--search-close-touch);
    height: var(--search-close-touch);
    flex: none;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: opacity 200ms ease-out;
  }

  .v3-search__close-circle {
    display: flex;
    width: var(--search-close-size);
    height: var(--search-close-size);
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    transition: background-color 150ms ease-out;
  }

  .v3-search__close-icon {
    width: var(--search-close-icon);
    height: var(--search-close-icon);
  }

  .v3-search__body {
    position: relative;
    display: flex;
    flex-direction: column;
    transition: opacity 250ms ease-out;
  }

  .v3-search[data-search-state='open'] .v3-search__logo {
    opacity: 1;
    transition-delay: 150ms;
  }

  .v3-search[data-search-state='open'] .v3-search__close {
    opacity: 1;
    transition-delay: 230ms;
  }

  .v3-search[data-search-state='open'] .v3-search__body {
    opacity: 1;
    transition-delay: 300ms;
  }

  .v3-search[data-search-state='closing'] .v3-search__logo,
  .v3-search[data-search-state='closing'] .v3-search__close,
  .v3-search[data-search-state='closing'] .v3-search__body {
    opacity: 0;
    transition: opacity 150ms ease-out;
  }

  .v3-search__scroll {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .v3-search__scroll::-webkit-scrollbar {
    display: none;
  }

  .v3-search__form {
    position: sticky;
    z-index: 1;
    top: var(--search-content-p);
    flex: none;
    background: var(--color-bg);
    padding: 0 var(--search-content-p) var(--search-content-p);
  }

  .v3-search__form::before {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: var(--search-content-p);
    background: var(--color-bg);
    content: '';
    pointer-events: none;
  }

  .v3-search__content {
    padding: 0 var(--search-content-p) var(--search-content-p);
  }

  .v3-search__states {
    padding-top: calc(var(--search-content-gap) - var(--search-content-p));
  }

  .v3-search__input-ring {
    position: relative;
    z-index: 1;
    border-radius: 9999px;
    transition: box-shadow 180ms ease-out;
  }

  .v3-search__input-ring:focus-within {
    box-shadow: 0 0 0 2px var(--color-search-focus);
  }

  .v3-search__input-field {
    display: flex;
    height: var(--search-input-h);
    align-items: center;
    gap: 16px;
    border: 1px solid var(--color-hover);
    border-radius: 9999px;
    background: var(--color-pressed);
    cursor: text;
    padding: 0 16px;
  }

  .v3-search__input-leading {
    display: grid;
    width: var(--size-13);
    height: var(--size-13);
    flex: none;
    place-items: center;
  }

  .v3-search__input-icon,
  .v3-search__input-back {
    grid-area: 1 / 1;
  }

  .v3-search__input-icon {
    display: flex;
  }

  .v3-search__input-icon svg {
    overflow: visible;
  }

  .v3-search__input-back {
    position: relative;
    display: flex;
    width: var(--size-13);
    height: var(--size-13);
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0;
  }

  .v3-search__input-back[hidden] {
    display: none;
  }

  .v3-search__input-back::before {
    position: absolute;
    inset: calc(var(--size-6) * -1);
    content: '';
  }

  .v3-search[data-search-origin] .v3-search__input-icon {
    display: none;
  }

  .v3-search__input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-ink);
    padding: 0;
    appearance: none;
    transform: translateY(var(--size-1));
  }

  .v3-search__input::-webkit-search-cancel-button {
    display: none;
  }

  .v3-search__input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  .v3-search__input-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0;
    transition: gap 180ms ease-out;
  }

  .v3-search[data-search-scrolled] .v3-search__input-actions {
    gap: var(--size-16);
  }

  .v3-search__input-clear {
    display: grid;
    height: var(--size-12);
    min-width: 0;
    max-width: 0;
    flex: none;
    align-items: center;
    justify-content: flex-end;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    opacity: 0;
    overflow: hidden;
    padding: 0;
    pointer-events: none;
    transition:
      max-width 180ms ease-out,
      opacity 150ms ease-out;
    visibility: hidden;
  }

