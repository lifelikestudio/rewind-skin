      background-color: var(--color-hover);
    }

    /* L1 — demote siblings within the same subgroup only */
    [data-l1-group][data-link-focused] .v3-submenu__l1-link {
      color: var(--color-demoted);
      transition: color 220ms ease-out;
    }
    [data-l1-group][data-link-focused] .v3-submenu__l1-link[data-focused] {
      color: var(--color-ink);
