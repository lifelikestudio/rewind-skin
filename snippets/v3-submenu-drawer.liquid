      --l1-pl: 32px;
      --l1-pr: 40px;
      --l1-py: 32px;
      --link-gap-l1: 16px;
      --subgroup-gap: 64px;
      --title-gap: 32px;
      --l2-pl: 40px;
      --l2-pr: 32px;
      --link-gap-l2: 14px;
      --quick-h: 32px;
      --utility-p: 32px;
      --utility-gap: 16px;
      --levels-pb: 20px;
    }
  }
  /* Cap exceptionally tall desktop drawers while preserving the current XL
     ceiling. Landscape SM–LG drawers otherwise fill the available viewport. */
  @media (min-width: 768px) and (orientation: portrait), (min-width: 1920px) {
    .v3-submenu {
      --drawer-max-h: 864px;
