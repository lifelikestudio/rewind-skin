{% comment %}
  V3 Sub-menu Drawer — desktop (SM+)
  Rendered by v3-navigation section. Content is hardcoded for development;
  will be replaced with dynamic link_list loops when the site transitions.

  Parameters (passed from section):
    logo        — image object from section settings
    shop_label  — text label for Shop toggle
    studio_label — text label for Studio toggle
    section_id  — parent section id
{% endcomment %}

{%- liquid
  assign cart_count = cart.item_count
  if cart_count > 99
    assign cart_bag_label = 'Bag (99+)'
  elsif cart_count > 0
    assign cart_bag_label = 'Bag (' | append: cart_count | append: ')'
  else
    assign cart_bag_label = 'Bag (0)'
  endif
-%}

<div
  class='v3-submenu'
  data-submenu
  data-context='shop'
  data-submenu-state='closed'
  aria-hidden='true'
>
  {%- comment -%} Page overlay {%- endcomment -%}
  <div class='v3-submenu__overlay' data-submenu-overlay></div>

  {%- comment -%} Drawer panel {%- endcomment -%}
  <div
    class='v3-submenu__drawer'
    role='dialog'
    aria-modal='true'
    aria-label='Navigation menu'
  >
    {%- comment -%} ═══ HEADING ═══ {%- endcomment -%}
    <div class='v3-submenu__heading'>
      <a
        href='{{ routes.root_url }}'
        class='block shrink-0'
        aria-label='{{ shop.name }}'
      >
        {%- if logo != blank -%}
          {{
            logo
            | image_url: width: 500
            | image_tag:
              class: 'w-[220px] lg:w-[248px] h-auto',
              widths: '220, 248, 440, 496',
              alt: logo.alt
            | default: shop.name
          }}
        {%- else -%}
          <svg
            class='h-auto w-[220px] lg:w-[248px]'
            viewBox='0 0 193.235 14'
            fill='none'
            xmlns='http://www.w3.org/2000/svg'
            aria-label='{{ shop.name }}'
            role='img'
          >
