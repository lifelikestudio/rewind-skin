            <path d="M38.2458 1.95506H23.485V6.44563H37.4377V7.87204H23.485V12.4154H38.2458V13.8419H21.7611V0.528646H38.2458V1.95506Z" fill="currentColor"/>
            <path d="M65.3963 0.528646L65.4502 0.581476L59.5243 13.789H57.9082L53.0597 2.58902L48.2113 13.789H46.5951L40.6693 0.581476L40.7231 0.528646H42.5009L47.2955 11.7286L52.1439 0.528646H53.9756L58.7701 11.7286L63.6186 0.528646H65.3963Z" fill="currentColor"/>
