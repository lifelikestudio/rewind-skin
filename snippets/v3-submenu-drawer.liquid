              <a href='#' class='v3-submenu__l1-link text-submenu-l1'>Gifting</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1'>Sales & Offers</a>
            </div>
          </div>

          {%- comment -%} ── Studio L1 ── {%- endcomment -%}
          <div class='v3-submenu__l1' data-submenu-context='studio'>
            <div class='v3-submenu__subgroup' data-l1-group>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1' data-l1='facials' data-has-l2>Facials</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1' data-l1='body-contouring' data-has-l2>Body Contouring</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1' data-l1='hair-removal' data-has-l2>Hair Removal</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1' data-l1='injectables' data-has-l2>Injectables</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1' data-l1='skin-improvement' data-has-l2>Skin Improvement</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1' data-l1='skin-tightening' data-has-l2>Skin Tightening</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1'>All Treatments</a>
            </div>
            <div class='v3-submenu__subgroup' data-l1-group>
              <span class='v3-submenu__subgroup-title text-submenu-caption'>Featured</span>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1'>Virtual Consult</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1'>Gifting</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1'>Your Therapist</a>
            </div>
          </div>

          {%- comment -%} ── L2 panels (Shop) ── {%- endcomment -%}
          <div class='v3-submenu__l2' data-l2='skincare' data-l2-context='shop'>
            <a href='#' class='v3-submenu__l2-link text-submenu-l2'>Cleansers</a>
            <a href='#' class='v3-submenu__l2-link text-submenu-l2'>Toners and Mists</a>
            <a href='#' class='v3-submenu__l2-link text-submenu-l2'>Creams and Moisturizers</a>
            <a href='#' class='v3-submenu__l2-link text-submenu-l2'>Exfoliants</a>
            <a href='#' class='v3-submenu__l2-link text-submenu-l2'>Eyes & Lips</a>
            <a href='#' class='v3-submenu__l2-link text-submenu-l2'>Masks and Treatments</a>
