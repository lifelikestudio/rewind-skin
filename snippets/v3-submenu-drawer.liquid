<style>
  /* ═══ CUSTOM PROPERTIES — SM/MD/MD-LG plateau (base) ═══ */
  .v3-submenu {
    --drawer-w: 522px;
    --drawer-inset: 12px;
    --drawer-r: 20px;
    --header-h: 86px;
    --header-pl: 24px;
    --header-pr: 10px;
    --header-py: 24px;
    --close-size: 38px;
    --l1-pl: 24px;
    --l1-pr: 32px;
    --l1-py: 24px;
    --l1-w: 221px;
    --link-gap-l1: 15px;
    --subgroup-gap: 56px;
    --title-gap: 30px;
    --l2-pl: 32px;
    --l2-pr: 24px;
    --link-gap-l2: 13px;
    --quick-h: 30px;
    --utility-p: 24px;
    --utility-gap: 14px;
    --levels-pb: 18px;
  }
  @media (min-width: 1280px) {
    .v3-submenu {
      --drawer-inset: 14px;
    }
  }
  /* LG/XL plateau */
  @media (min-width: 1440px) {
    .v3-submenu {
      --drawer-w: 571px;
      --drawer-inset: 16px;
      --drawer-r: 24px;
      --header-h: 104px;
      --header-pl: 32px;
      --header-pr: 17px;
      --header-py: 32px;
      --close-size: 40px;
      --l1-pl: 32px;
      --l1-pr: 40px;
      --l1-py: 32px;
      --l1-w: 255px;
      --link-gap-l1: 16px;
      --subgroup-gap: 64px;
      --title-gap: 32px;
      --l2-pl: 40px;
      --l2-pr: 32px;
      --link-gap-l2: 14px;
      --quick-h: 32px;
      --utility-p: 32px;
      --utility-gap: 16px;
      --levels-pb: 20px;
    }
  }

  /* ═══ TYPOGRAPHY FOUNDATION ═══ */
  .v3-submenu {
    font-family:
      'Scto Grotesk A',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      Oxygen-Sans,
      Ubuntu,
      Cantarell,
      'Helvetica Neue',
      sans-serif;
    font-weight: 400;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .v3-submenu button,
  .v3-submenu a {
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .v3-submenu a,
  .v3-submenu a:visited {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* ═══ CONTAINER — hidden below SM, fixed fullscreen at SM+ ═══ */
  .v3-submenu {
    display: none;
  }
  @media (min-width: 768px) {
    .v3-submenu {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 50;
      visibility: hidden;
      pointer-events: none;
    }
    .v3-submenu[data-submenu-state='open'] {
      visibility: visible;
      pointer-events: auto;
    }
  }

  /* ═══ PAGE OVERLAY ═══ */
  .v3-submenu__overlay {
    position: absolute;
    inset: 0;
    background: rgba(251, 250, 249, 0.5);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
