          </svg>
        {%- endif -%}
      </a>

      <div class='v3-submenu__actions'>
        {%- comment -%} Shop / Studio toggle {%- endcomment -%}
        <div
          class='v3-submenu__toggle-group bg-rest rounded-pill'
          role='group'
          aria-label='Navigation context'
        >
          <button
            type='button'
            class='v3-submenu__toggle-btn rounded-pill text-nav-label font-base tracking-tight'
            data-submenu-toggle='shop'
            aria-pressed='true'
          >
            {{ shop_label | default: 'Shop' }}
          </button>
          <button
            type='button'
            class='v3-submenu__toggle-btn rounded-pill text-nav-label font-base tracking-tight'
            data-submenu-toggle='studio'
            aria-pressed='false'
          >
            {{ studio_label | default: 'Studio' }}
          </button>
        </div>

        {%- comment -%} Close {%- endcomment -%}
        <button
          type='button'
          class='v3-submenu__close'
          data-submenu-close
          aria-label='Close menu'
        >
          {%- render 'v3-icon-close', size: 10, class: 'text-ink' -%}
        </button>
      </div>
    </div>

    {%- comment -%} ═══ NAVIGATION BODY ═══ {%- endcomment -%}
    <div class='v3-submenu__nav'>
      {%- comment -%} NavigationLevels — flex-1, space-between for primary + quick {%- endcomment -%}
      <div class='v3-submenu__levels'>
        {%- comment -%} PrimaryLinks — L1 and L2 side-by-side {%- endcomment -%}
        <div class='v3-submenu__primary' data-submenu-primary>
          {%- comment -%} ── Shop L1 ── {%- endcomment -%}
          <div class='v3-submenu__l1' data-submenu-context='shop'>
            <div class='v3-submenu__subgroup' data-l1-group>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1' data-l1='skincare' data-has-l2>Skincare</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1'>Hair & Body</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1'>Tools & Accessories</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1' data-l1='brands' data-has-l2>Brands</a>
              <a href='#' class='v3-submenu__l1-link text-submenu-l1'>Shop All</a>
            </div>
            <div class='v3-submenu__subgroup' data-l1-group>
              <span class='v3-submenu__subgroup-title text-submenu-caption'>Featured</span>
