      </a>

      <div class='v3-submenu__actions'>
        {%- comment -%} Shop / Studio toggle {%- endcomment -%}
        <div
          class='v3-submenu__toggle-group bg-rest rounded-pill'
          role='group'
          aria-label='Navigation context'
          data-submenu-toggle-group
        >
          <span
            class='v3-submenu__toggle-pill rounded-pill bg-bg'
            aria-hidden='true'
            data-submenu-pill
          ></span>
          <button
            type='button'
            class='v3-submenu__toggle-btn rounded-pill text-nav-label font-base tracking-tight'
            data-submenu-toggle='shop'
            aria-pressed='true'
          >
            {{ shop_label | default: 'Shop' }}
          </button>
          <button
            type='button'
            class='v3-submenu__toggle-btn rounded-pill text-nav-label font-base tracking-tight'
            data-submenu-toggle='studio'
            aria-pressed='false'
          >
            {{ studio_label | default: 'Studio' }}
          </button>
        </div>

        {%- comment -%} Close {%- endcomment -%}
        <button
          type='button'
          class='v3-submenu__close'
          data-submenu-close
          aria-label='Close menu'
        >
          {%- render 'v3-icon-close', size: 12, class: 'text-ink' -%}
        </button>
      </div>
    </div>

    {%- comment -%} ═══ NAVIGATION BODY ═══ {%- endcomment -%}
    <div class='v3-submenu__nav'>
