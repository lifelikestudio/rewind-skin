{% comment %}
  V3 Cart icon — shopping cart with wheels.
  Renders at currentColor; size controlled by parent.

  Parameters:
    size        — fallback width/height in px (default: 26)
    class       — CSS classes on the <svg>
    frame_size  — when set, expands viewBox to this square size and centres
                  the artwork within it (use for bare icon triggers where the
                  bounding box is larger than the artwork)
{% endcomment %}
{%- liquid
  assign _size = size | default: 26
  assign _artwork_w = 22.91
  assign _artwork_h = 22.812
-%}
{%- if frame_size -%}
  {%- assign _offset_x = frame_size | minus: _artwork_w | divided_by: 2.0 -%}
  {%- assign _offset_y = frame_size | minus: _artwork_h | divided_by: 2.0 -%}
<svg
  class="{{ class }}"
  width="{{ _size }}"
  height="{{ _size }}"
  viewBox="0 0 {{ frame_size }} {{ frame_size }}"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <g transform="translate({{ _offset_x }}, {{ _offset_y }})">
    <path d="M7.05052 22.212C7.64883 22.212 8.13385 21.727 8.13385 21.1286C8.13385 20.5303 7.64883 20.0453 7.05052 20.0453C6.45221 20.0453 5.96719 20.5303 5.96719 21.1286C5.96719 21.727 6.45221 22.212 7.05052 22.212Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M18.9646 22.212C19.5629 22.212 20.0479 21.727 20.0479 21.1286C20.0479 20.5303 19.5629 20.0453 18.9646 20.0453C18.3663 20.0453 17.8813 20.5303 17.8813 21.1286C17.8813 21.727 18.3663 22.212 18.9646 22.212Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M0.6 0.6H2.76667L5.64833 14.055C5.75404 14.5478 6.02823 14.9883 6.42369 15.3007C6.81915 15.6131 7.31115 15.7779 7.815 15.7667H18.41C18.9031 15.7659 19.3812 15.5969 19.7653 15.2877C20.1494 14.9784 20.4165 14.5474 20.5225 14.0658L22.31 6.01667H3.92583" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>
{%- else -%}
<svg
  class="{{ class }}"
  width="{{ _size }}"
  height="{{ _size }}"
  viewBox="0 0 {{ _artwork_w }} {{ _artwork_h }}"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <path d="M7.05052 22.212C7.64883 22.212 8.13385 21.727 8.13385 21.1286C8.13385 20.5303 7.64883 20.0453 7.05052 20.0453C6.45221 20.0453 5.96719 20.5303 5.96719 21.1286C5.96719 21.727 6.45221 22.212 7.05052 22.212Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M18.9646 22.212C19.5629 22.212 20.0479 21.727 20.0479 21.1286C20.0479 20.5303 19.5629 20.0453 18.9646 20.0453C18.3663 20.0453 17.8813 20.5303 17.8813 21.1286C17.8813 21.727 18.3663 22.212 18.9646 22.212Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M0.6 0.6H2.76667L5.64833 14.055C5.75404 14.5478 6.02823 14.9883 6.42369 15.3007C6.81915 15.6131 7.31115 15.7779 7.815 15.7667H18.41C18.9031 15.7659 19.3812 15.5969 19.7653 15.2877C20.1494 14.9784 20.4165 14.5474 20.5225 14.0658L22.31 6.01667H3.92583" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{%- endif -%}
