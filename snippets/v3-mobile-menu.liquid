{% comment %}
  V3 Mobile Menu — full-screen frosted glass overlay below SM.
  Rendered by v3-navigation section. Content is hardcoded for development;
  will be replaced with dynamic link_list loops when the site transitions.

  Interaction model: drill-in/drill-out (L2 replaces L1, back button returns).
  Desktop uses side-by-side L2 reveal in v3-submenu-drawer.liquid.

  Parameters (passed from section):
    logo                 — image object from section settings
    shop_label           — text label for Shop toggle
    studio_label         — text label for Studio toggle
    shop_menu            — reserved Shop main menu
    shop_featured_menu   — reserved Shop featured menu
    shop_utility_menu    — reserved Shop utility menu
    studio_menu          — reserved Studio main menu
    studio_featured_menu — reserved Studio featured menu
    studio_utility_menu  — reserved Studio utility menu
    bag_label            — cart label
    show_search          — whether search entry points are enabled
    show_cart            — whether cart entry points are enabled
    show_account         — whether account entry points are enabled
    section_id           — parent section id
{% endcomment %}

{%- liquid
  assign shop_context_label = shop_label | default: 'Shop'
  assign studio_context_label = studio_label | default: 'Studio'
  assign cart_count = cart.item_count
  assign cart_bag_label = bag_label
  if cart_bag_label == blank
    assign cart_bag_label = 'sections.v3_cart.bag' | t
  endif
  if cart_count > 99
    assign cart_trigger_label = cart_bag_label | append: ' (99+)'
  elsif cart_count > 0
    assign cart_trigger_label = cart_bag_label | append: ' (' | append: cart_count | append: ')'
  else
    assign cart_trigger_label = cart_bag_label
  endif
-%}

<nav
  id='v3-mobile-menu-{{ section_id }}'
  class='v3-mobile-menu'
  data-mobile-menu
  data-mobile-menu-context='shop'
  data-mobile-menu-state='closed'
  aria-hidden='true'
  aria-label='{{ 'sections.v3_navigation.mobile_navigation' | t | escape }}'
>
  {%- comment -%} Screen-reader announcement for context/level changes {%- endcomment -%}
  <span
    class='sr-only'
    aria-live='polite'
    aria-atomic='true'
    data-mobile-menu-announce
  ></span>

  {%- comment -%} Panel (frosted glass surface) {%- endcomment -%}
