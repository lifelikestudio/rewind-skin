<style>
  /* ═══ CUSTOM PROPERTIES — TINY (base, <375px) ═══ */
  .v3-mobile-menu {
    --panel-inset: 7px;
    --panel-r: 19px;
    --header-pl: 20px;
    --header-pr: 2px;
    --header-py: 14px;
    --content-px: 20px;
    --content-pb: 22px;
    --close-touch: 44px;
    --close-size: 32px;
    --close-icon: 11px;
    --toggle-nav-gap: 28px;
    --link-gap: 13px;
    --subgroup-gap: 48px;
    --title-gap: 27px;
    --toggle-track-h: 38px;
    --toggle-btn-h: 34px;
    --toggle-px: 26px;
    --quick-h: 28px;
    --quick-px: 13px;
    --quick-touch: 44px;
    --levels-pb: 8px;
    --utility-px: 20px;
    --utility-py: 4.5px;
    --utility-gap: 14px;
    --l2-back-gap: 27px;
    --l2-links-gap: 28px;
  }
  /* XXS — 375px+ */
  @media (min-width: 375px) {
    .v3-mobile-menu {
      --panel-inset: 8px;
      --panel-r: 19px;
      --header-pl: 22px;
      --header-pr: 5px;
      --header-py: 18px;
      --content-px: 22px;
      --content-pb: 23px;
      --close-size: 36px;
      --close-icon: 12px;
      --toggle-nav-gap: 30px;
      --link-gap: 14px;
      --subgroup-gap: 52px;
      --title-gap: 28px;
      --toggle-track-h: 40px;
      --toggle-btn-h: 36px;
      --toggle-px: 30px;
      --quick-h: 29px;
      --quick-px: 13px;
      --levels-pb: 9.5px;
      --utility-px: 22px;
      --utility-py: 6px;
      --l2-back-gap: 30px;
      --l2-links-gap: 30px;
    }
  }
  /* XS — 428px+ (capped at SM) */
  @media (min-width: 428px) {
    .v3-mobile-menu {
      --panel-inset: 8px;
      --panel-r: 20px;
      --header-pl: 24px;
      --header-pr: 7px;
      --header-py: 21px;
      --content-px: 24px;
      --content-pb: 24px;
      --close-size: 38px;
      --close-icon: 12px;
      --toggle-nav-gap: 32px;
      --link-gap: 14.5px;
      --subgroup-gap: 56px;
      --title-gap: 30px;
      --toggle-track-h: 40px;
      --toggle-btn-h: 36px;
      --toggle-px: 32px;
      --quick-h: 30px;
      --quick-px: 14px;
      --levels-pb: 11px;
      --utility-px: 24px;
      --utility-py: 7px;
      --l2-back-gap: 30px;
      --l2-links-gap: 30px;
    }
  }

  /* ═══ TYPOGRAPHY FOUNDATION ═══ */
  .v3-mobile-menu {
    font-family:
      'Scto Grotesk A',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      Oxygen-Sans,
      Ubuntu,
      Cantarell,
      'Helvetica Neue',
      sans-serif;
    font-weight: 400;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .v3-mobile-menu button,
  .v3-mobile-menu a {
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .v3-mobile-menu a,
  .v3-mobile-menu a:visited {
    color: var(--color-ink);
    text-decoration: none;
  }

  /* ═══ CONTAINER — visible below SM only, fixed fullscreen ═══ */
  .v3-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    visibility: hidden;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .v3-mobile-menu {
      display: none;
    }
  }
  .v3-mobile-menu[data-mobile-menu-state='open'],
  .v3-mobile-menu[data-mobile-menu-state='closing'] {
    visibility: visible;
    pointer-events: auto;
  }
  .v3-mobile-menu[data-mobile-menu-state='closing'] {
    pointer-events: none;
  }

  /* ═══ PANEL (frosted glass surface) ═══ */
  .v3-mobile-menu__panel {
    position: absolute;
    inset: var(--panel-inset);
    background: rgba(251, 250, 249, 0.5);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    border-radius: var(--panel-r);
    overflow: clip;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity 250ms ease-out;
  }
  .v3-mobile-menu[data-mobile-menu-state='open'] .v3-mobile-menu__panel {
    opacity: 1;
  }
  .v3-mobile-menu[data-mobile-menu-state='closing'] .v3-mobile-menu__panel {
    opacity: 0;
    transition: opacity 180ms ease-out;
  }

  /* ═══ CHOREOGRAPHED ENTRANCE ═══ */
  .v3-mobile-menu__heading {
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .v3-mobile-menu__toggle-wrap {
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .v3-mobile-menu__nav {
    opacity: 0;
    transition: opacity 250ms ease-out;
  }
  .v3-mobile-menu__utility {
    opacity: 0;
    transition: opacity 250ms ease-out;
  }
  .v3-mobile-menu[data-mobile-menu-state='open'] .v3-mobile-menu__heading {
    opacity: 1;
    transition: opacity 200ms ease-out 150ms;
  }
