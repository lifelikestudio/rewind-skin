{
  "name": "rewind-skin",
  "version": "1.0.0",
  "description": "Rewind Skin website",
  "main": "global.js",
  "scripts": {
    "capsize": "node ./src/capsize.js",
    "capsize:v3": "node ./src/capsize-v3.js",
    "tailwind": "npx @tailwindcss/cli -i ./src/v2-1-0.input.css -o ./assets/v2-1-0.output.css --watch",
    "tailwind:v3": "npx @tailwindcss/cli -i ./src/v3.input.css -o ./assets/v3.output.css --watch",
    "tailwind:v3:build": "npx @tailwindcss/cli -i ./src/v3.input.css -o ./assets/v3.output.css",
    "build:v3": "npm run capsize:v3 && npm run tailwind:v3:build",
    "build:js:dev": "webpack --mode development",
    "build:js": "webpack --mode production",
    "start": "webpack --watch --mode development",
    "build": "npm run build:js && npm run capsize && npm run build:v3",
    "theme:dev": "shopify theme dev --environment live --theme-editor-sync",
    "theme:release": "shopify theme push --environment live-release"
  },
  "dependencies": {
    "@capsizecss/core": "^4.1.2",
    "@capsizecss/metrics": "^3.5.0",
    "@tailwindcss/cli": "^4.1.12",
    "@typeform/embed": "^4.3.0",
    "axios": "^1.5.0",
    "embla-carousel": "^8.0.0-rc11",
    "embla-carousel-wheel-gestures": "^8.0.0-rc05",
    "gsap": "^3.12.2",
    "keen-slider": "^6.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "@capsizecss/unpack": "^4.0.1",
    "@shopify/prettier-plugin-liquid": "^1.10.0",
    "@tailwindcss/postcss": "^4.1.12",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "mini-css-extract-plugin": "^2.9.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "style-loader": "^3.3.4",
    "tailwindcss": "^4.1.12",
    "webpack": "^5.101.3",
    "webpack-cli": "^5.1.4"
  }
}
